<!doctype html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <title><%= typeof title !== 'undefined' ? title : 'LinkPro Admin' %></title>
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;600;800&display=swap" rel="stylesheet">
    <style>
        :root {
            --bg: #000000; /* Negro puro */
            --card-bg: #0a0a0a; 
            --primary: #00ff66; /* Verde Neón potente */
            --text: #ffffff;
            --text-dim: #a1a1aa;
            --border: #1a1a1a;
        }

        body {
            background: var(--bg);
            color: var(--text);
            font-family: 'Inter', sans-serif;
            margin: 0;
            font-size: 16px; /* Letra más grande de base */
        }

        .topbar {
            padding: 20px 40px;
            border-bottom: 1px solid var(--border);
            display: flex;
            justify-content: space-between;
            align-items: center;
        }

        .topbar-logo {
            font-weight: 800;
            color: var(--primary);
            font-size: 24px;
            letter-spacing: -1px;
        }

        .nav-links { display: flex; gap: 20px; }
        .nav-link {
            text-decoration: none;
            color: var(--text-dim);
            font-weight: 600;
            transition: 0.3s;
        }
        .nav-link:hover, .nav-link.active { color: var(--primary); }

        .container { max-width: 1200px; margin: 40px auto; padding: 0 20px; }
        
        /* Estilo para botones potentes */
        .btn-glow {
            background: var(--primary);
            color: #000;
            padding: 14px 28px;
            border-radius: 12px;
            font-weight: 800;
            text-decoration: none;
            text-transform: uppercase;
            box-shadow: 0 0 20px rgba(0, 255, 102, 0.3);
            transition: 0.3s;
            border: none;
            cursor: pointer;
            font-size: 15px;
        }
        .btn-glow:hover { transform: scale(1.05); box-shadow: 0 0 30px rgba(0, 255, 102, 0.5); }
    </style>
</head>
<body>
    <header class="topbar">
        <div class="topbar-logo">LINKPRO_</div>
        <nav class="nav-links">
            <a href="/admin/dashboard" class="nav-link <%= (locals.currentSection === 'dashboard') ? 'active' : '' %>">Dashboard</a>
            <a href="/admin/clients" class="nav-link <%= (locals.currentSection === 'clients') ? 'active' : '' %>">Clientes</a>
            <a href="/admin/links" class="nav-link <%= (locals.currentSection === 'links') ? 'active' : '' %>">Links</a>
            <a href="/admin/logout" class="nav-link" style="color: #ff4444;">Salir</a>
        </nav>
    </header>

    <main class="container">
        <%- body %> </main>
</body>
</html>