<!doctype html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <title>Admin Panel | LinkPro</title>
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;600&display=swap" rel="stylesheet">
    <style>
        :root {
            --bg: #0b0e14;
            --card-bg: #151921;
            --primary: #3b82f6;
            --text: #f3f4f6;
            --border: #2d333b;
            --input-bg: #0b0e14;
        }

        body {
            background: var(--bg);
            color: var(--text);
            font-family: 'Inter', sans-serif;
            margin: 0;
            display: flex;
            justify-content: center;
            align-items: center;
            min-height: 100vh;
        }

        .wrap { width: 100%; max-width: 600px; padding: 20px; }

        .card {
            background: var(--card-bg);
            padding: 40px;
            border-radius: 20px;
            border: 1px solid var(--border);
            box-shadow: 0 10px 30px rgba(0,0,0,0.5);
        }

        h1 { font-size: 24px; margin-bottom: 30px; text-align: center; }

        label { display: block; margin-bottom: 8px; font-weight: 600; font-size: 14px; color: #9ca3af; }

        input, select {
            width: 100%;
            padding: 12px;
            margin-bottom: 20px;
            background: var(--input-bg);
            border: 1px solid var(--border);
            border-radius: 8px;
            color: white;
            box-sizing: border-box;
            transition: border 0.3s;
        }

        input:focus { border-color: var(--primary); outline: none; }

        .row { display: grid; grid-template-columns: 1fr 1fr; gap: 15px; }

        .btn {
            padding: 12px 20px;
            border-radius: 8px;
            cursor: pointer;
            font-weight: 600;
            border: none;
            transition: all 0.3s;
        }

        .primary { background: var(--primary); color: white; width: 100%; }
        .primary:hover { opacity: 0.9; transform: translateY(-2px); }

        .ghost { background: transparent; color: #ef4444; border: 1px solid #ef4444; margin-top: 10px; width: 100%; }
        .ghost:hover { background: #ef4444; color: white; }

        /* Modal simple */
        #modalBackdrop {
            display: none;
            position: fixed;
            top: 0; left: 0; width: 100%; height: 100%;
            background: rgba(0,0,0,0.8);
            justify-content: center;
            align-items: center;
            z-index: 100;
        }
        .modal {
            background: var(--card-bg);
            padding: 30px;
            border-radius: 15px;
            text-align: center;
            border: 1px solid var(--primary);
        }
    </style>
</head>
<body>

<div class="wrap">
    <div class="card">
        <h1>🚀 Panel de Control</h1>
        <form id="genForm" enctype="multipart/form-data">
            <input type="hidden" id="linkId" name="id">

            <label for="customDomain">Dominio Propio (Opcional)</label>
            <input type="text" id="customDomain" name="custom_domain" placeholder="ej: midominio.com" />

            <label for="slug">Slug / ID (Ruta del link)</label>
            <input type="text" id="slug" name="slug" placeholder="ej: mvictoria" required />

            <div class="row">
                <div>
                    <label for="displayName">Nombre en Pantalla</label>
                    <input type="text" id="displayName" name="display_name" required />
                </div>
                <div>
                    <label for="subtitle">Subtítulo / Profesión</label>
                    <input type="text" id="subtitle" name="subtitle" />
                </div>
            </div>

            <label for="instagram">Instagram URL</label>
            <input type="url" id="instagram" name="instagram" />

            <label for="onlyfans">OnlyFans URL</label>
            <input type="url" id="onlyfans" name="onlyfans" />

            <label for="photo">Foto de Perfil</label>
            <input type="file" id="photo" name="file" accept="image/*" />

            <label>Modo de Visualización 🎯</label>
            <div class="row" style="background: var(--bg); padding: 15px; border-radius: 12px; border: 1px solid var(--border); margin-bottom: 20px;">
                <label style="margin:0"><input type="radio" name="link_mode" value="landing" checked /> Landing</label>
                <label style="margin:0"><input type="radio" name="link_mode" value="instructions" /> Instrucciones</label>
            </div>

            <div class="actions">
                <button type="submit" class="btn primary">Guardar Smart Link</button>
                <button type="button" id="logoutBtn" class="btn ghost">Cerrar Sesión</button>
            </div>
        </form>
    </div>
</div>

<div id="modalBackdrop">
    <div class="modal">
        <h2>✅ ¡Link Guardado!</h2>
        <p>Tu link está listo en:</p>
        <code id="modalLinkText" style="display: block; background: #000; padding: 10px; margin: 15px 0;"></code>
        <button onclick="location.reload()" class="btn primary">Aceptar</button>
    </div>
</div>

<script>
    // Lógica que tenías en private-link.js
    const form = document.querySelector('#genForm');
    const logoutBtn = document.querySelector('#logoutBtn');

    form.addEventListener('submit', async (e) => {
        e.preventDefault();
        const formData = new FormData(form);
        
        try {
            // Asegúrate que esta ruta exista en tu admin.routes.js
            const response = await fetch('/admin/save', { 
                method: 'POST',
                body: formData 
            });

            const result = await response.json();

            if (result.success) {
                const domain = document.querySelector('#customDomain').value || window.location.host;
                const slug = document.querySelector('#slug').value;
                const finalLink = `https://${domain}/${slug}`;
                
                document.querySelector('#modalLinkText').textContent = finalLink;
                document.querySelector('#modalBackdrop').style.display = 'flex';
            } else {
                alert('Error: ' + result.error);
            }
        } catch (err) {
            alert('Fallo en la conexión');
        }
    });

    logoutBtn.addEventListener('click', () => {
        window.location.href = '/admin/logout';
    });
</script>

</body>
</html>