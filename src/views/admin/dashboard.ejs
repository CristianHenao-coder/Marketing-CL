<div class="page-header" style="margin-bottom: 40px;">
    <h1 style="font-size: 42px; font-weight: 800; margin: 0;">ESTADÍSTICAS_</h1>
    <p style="color: var(--text-dim); font-size: 18px;">Rendimiento global de la infraestructura.</p>
</div>

<style>
    .grid-stats {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
        gap: 25px;
    }

    .stat-card {
        background: var(--card-bg);
        border: 1px solid var(--border);
        padding: 30px;
        border-radius: 20px;
        transition: 0.3s;
    }

    .stat-card:hover {
        border-color: var(--primary);
    }

    .stat-label {
        color: var(--text-dim);
        text-transform: uppercase;
        font-size: 13px;
        letter-spacing: 2px;
        font-weight: 600;
    }

    .stat-value {
        font-size: 48px;
        font-weight: 800;
        margin: 10px 0;
        color: var(--primary);
    }
</style>

<div class="grid-stats">
    <div class="stat-card">
        <div class="stat-label">Clics Totales</div>
        <div class="stat-value">
            <%= stats?.totalClicks || 0 %>
        </div>
    </div>
    <div class="stat-card">
        <div class="stat-label">Links Activos</div>
        <div class="stat-value" style="color: #fff;">
            <%= stats?.activeLinks || 0 %>
        </div>
    </div>
    <div class="stat-card">
        <div class="stat-label">Total Links</div>
        <div class="stat-value" style="color: #fff;">
            <%= stats?.totalLinks || 0 %>
        </div>
    </div>
</div>

<div style="margin-top: 50px; text-align: right;">
    <a href="/admin/links" class="btn-glow">Crear Nuevo Link ➜</a>
</div>

<!-- META SHIELD BANNER -->
<div
    style="margin-top: 40px; background: linear-gradient(135deg, #0d0008, #12000f); border: 1px solid #e1306c44; border-radius: 20px; padding: 28px 32px; display: flex; align-items: center; gap: 28px;">
    <div style="font-size: 42px; flex-shrink: 0;">🛡️</div>
    <div style="flex: 1;">
        <div
            style="font-size: 10px; letter-spacing: 2px; color: #e1306c; text-transform: uppercase; margin-bottom: 5px;">
            Servicio Activo</div>
        <div style="font-size: 20px; font-weight: 800; color: white; margin-bottom: 6px;">META SHIELD</div>
        <div style="font-size: 13px; color: #888; line-height: 1.5;">Todos los links están protegidos contra el escaneo
            de código fuente de Instagram y Threads. El dominio destino viaja cifrado — Meta no puede detectarlo.</div>
    </div>
    <div style="display: flex; flex-direction: column; gap: 8px; flex-shrink: 0; text-align: right;">
        <div style="display: flex; align-items: center; gap: 8px; font-size: 12px; color: #aaa;"><span
                style="width: 7px; height: 7px; border-radius: 50%; background: #00ff88; box-shadow: 0 0 8px #00ff88; display: inline-block;"></span>
            Anti Source Scanner</div>
        <div style="display: flex; align-items: center; gap: 8px; font-size: 12px; color: #aaa;"><span
                style="width: 7px; height: 7px; border-radius: 50%; background: #00ff88; box-shadow: 0 0 8px #00ff88; display: inline-block;"></span>
            Escape Browser Interno</div>
        <div style="display: flex; align-items: center; gap: 8px; font-size: 12px; color: #aaa;"><span
                style="width: 7px; height: 7px; border-radius: 50%; background: #00ff88; box-shadow: 0 0 8px #00ff88; display: inline-block;"></span>
            iOS + Android</div>
    </div>
</div>