<html lang="es">

<head>
    <meta charset="utf-8" />
    <title>Smart Links | Panel Admin</title>
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;600&display=swap" rel="stylesheet">
    <style>
        :root {
            --bg: #000000;
            --card-bg: #050505;
            --primary: #00ff66;
            /* Verde Neón */
            --text: #f3f4f6;
            --border: #1a1a1a;
            --input-bg: #0a0a0a;
            --accent: #00ff66;
        }

        * {
            box-sizing: border-box;
        }

        body {
            background: var(--bg);
            color: var(--text);
            font-family: 'Inter', sans-serif;
            margin: 0;
            min-height: 100vh;
            display: flex;
            flex-direction: column;
        }

        /* 🔹 Barra superior */
        .topbar {
            width: 100%;
            padding: 14px 24px;
            border-bottom: 1px solid var(--border);
            background: #000;
            display: flex;
            align-items: center;
            justify-content: space-between;
        }

        .topbar-left {
            display: flex;
            align-items: center;
            gap: 10px;
        }

        .topbar-logo {
            width: 32px;
            height: 32px;
            border-radius: 8px;
            background: var(--primary);
            color: #000;
            display: flex;
            align-items: center;
            justify-content: center;
            font-weight: 800;
        }

        .topbar-title span:first-child {
            font-size: 14px;
            font-weight: 600;
        }

        .topbar-title span:last-child {
            font-size: 11px;
            color: #666;
            display: block;
        }

        .topbar-nav {
            display: flex;
            gap: 12px;
        }

        .topbar-link {
            padding: 8px 16px;
            border-radius: 4px;
            font-size: 13px;
            text-decoration: none;
            color: #9ca3af;
            transition: 0.3s;
        }

        .topbar-link.active {
            color: var(--primary);
            background: rgba(0, 255, 102, 0.1);
        }

        .app-main {
            padding: 40px 24px;
            display: flex;
            justify-content: center;
        }

        .wrap {
            width: 100%;
            max-width: 700px;
        }

        .card {
            background: var(--card-bg);
            padding: 32px;
            border-radius: 12px;
            border: 1px solid var(--border);
        }

        h1 {
            font-size: 24px;
            color: var(--primary);
            margin-bottom: 8px;
        }

        .subtitle {
            font-size: 13px;
            color: #666;
            margin-bottom: 24px;
        }

        label {
            display: block;
            margin-bottom: 8px;
            font-size: 12px;
            color: #9ca3af;
            text-transform: uppercase;
            letter-spacing: 1px;
        }

        input,
        select {
            width: 100%;
            padding: 12px;
            margin-bottom: 16px;
            background: var(--input-bg);
            border: 1px solid var(--border);
            border-radius: 6px;
            color: white;
            font-size: 14px;
            transition: 0.3s;
        }

        input:focus {
            border-color: var(--primary);
            outline: none;
            box-shadow: 0 0 10px rgba(0, 255, 102, 0.1);
        }

        .row {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 20px;
        }

        .grid-3 {
            display: grid;
            grid-template-columns: 1fr 1fr 1fr;
            gap: 15px;
        }

        .btn {
            padding: 14px;
            border-radius: 6px;
            cursor: pointer;
            font-weight: 700;
            border: none;
            transition: 0.3s;
            width: 100%;
        }

        .primary {
            background: var(--primary);
            color: #000;
        }

        .primary:hover {
            transform: translateY(-2px);
            box-shadow: 0 5px 15px rgba(0, 255, 102, 0.3);
        }

        .ghost {
            background: transparent;
            color: #ff4d4d;
            border: 1px solid #ff4d4d;
            margin-top: 10px;
        }

        /* Buscador Clientes */
        #clientDropdown {
            position: absolute;
            background: #0a0a0a;
            border: 1px solid var(--border);
            width: 100%;
            z-index: 50;
            max-height: 200px;
            overflow-y: auto;
            border-radius: 6px;
        }

        .client-item {
            padding: 10px;
            cursor: pointer;
            border-bottom: 1px solid #111;
            font-size: 13px;
            color: #eee;
            text-align: left;
            width: 100%;
            background: none;
            border-left: none;
            border-right: none;
        }

        .client-item:hover {
            background: #151515;
            color: var(--primary);
        }

        /* Modal */
        #modalBackdrop {
            display: none;
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background: rgba(0, 0, 0, 0.9);
            justify-content: center;
            align-items: center;
            z-index: 1000;
        }

        .modal {
            background: #000;
            padding: 30px;
            border-radius: 12px;
            border: 1px solid var(--primary);
            text-align: center;
            max-width: 400px;
        }

        code {
            display: block;
            background: #111;
            padding: 15px;
            margin: 20px 0;
            border-radius: 6px;
            color: var(--primary);
            border: 1px dashed var(--primary);
        }

        .hidden {
            display: none;
        }

        .text-neon {
            color: var(--primary);
        }
    </style>

</head>

<body>

    </header>

    <main class="app-main">
        <div class="wrap">

            <h1>🚀 Crear Smart Link</h1>
            <p class="subtitle">Configuración de despliegue y datos comerciales de la modelo.</p>

            <form id="genForm" enctype="multipart/form-data">
                <div class="row">
                    <div>
                        <label>Dominio Propio</label>
                        <input type="text" id="customDomain" name="custom_domain" placeholder="ej: midominio.com" />
                    </div>
                    <div>
                        <label>Slug (Ruta)</label>
                        <input type="text" id="slug" name="slug" placeholder="ej: mvictoria" required />
                    </div>
                </div>

                <div class="row">
                    <div>
                        <label>Nombre en Pantalla</label>
                        <input type="text" id="displayName" name="display_name" required />
                    </div>
                    <div>
                        <label>Subtítulo</label>
                        <input type="text" id="subtitle" name="subtitle" placeholder="Model / Artist" />
                    </div>
                </div>

                <div class="row">
                    <div>
                        <label>Instagram URL</label>
                        <input type="url" id="instagram" name="instagram" />
                    </div>
                    <div>
                        <label>OnlyFans URL</label>
                        <input type="url" id="onlyfans" name="onlyfans" />
                    </div>
                </div>

                <div class="row">
                    <div>
                        <label>Telegram URL (Principal)</label>
                        <input type="url" id="telegram" name="telegram" placeholder="https://t.me/..." />
                    </div>
                    <div>
                        <label>TikTok URL</label>
                        <input type="url" id="tiktok" name="tiktok" placeholder="https://tiktok.com/..." />
                    </div>
                </div>

                <label>Foto de Perfil</label>
                <input type="file" id="photo" name="file" accept="image/*" />

                <label>Cliente / Modelo</label>
                <div style="position:relative">
                    <input type="text" id="clientSearch" placeholder="Busca por nombre o crea uno nuevo..."
                        autocomplete="off">
                    <div id="clientDropdown" class="hidden"></div>
                </div>
                <p id="clientSelectedInfo" style="font-size:11px; color:#666; margin-top:-10px; margin-bottom:15px;">
                    Ningún cliente seleccionado.</p>
                <input type="hidden" id="clientId" name="client_id">

                <div id="newClientFields" class="hidden"
                    style="background:rgba(0,255,102,0.05); padding:15px; border-radius:8px; border: 1px solid #111; margin-bottom:20px;">
                    <p style="font-size:11px; color:var(--primary); margin:0 0 10px 0">✨ Datos del Nuevo Cliente:</p>
                    <input type="text" id="newClientName" name="new_client_name" placeholder="Nombre completo">
                    <input type="text" id="newClientContact" name="new_client_contact"
                        placeholder="Telegram o WhatsApp">
                </div>

                <div class="grid-3">
                    <div>
                        <label>Precio (USD)</label>
                        <input type="number" step="0.01" id="price" name="price" value="30">
                    </div>
                    <div>
                        <label>Vencimiento</label>
                        <input type="date" id="fechaVencimiento" name="fecha_vencimiento">
                    </div>
                    <div style="display:flex; align-items:flex-start; padding-top:22px;">
                        <button type="button" id="btnMarcarPagado" class="btn"
                            style="background: #111; border: 1px solid var(--primary); color: var(--primary); font-size: 11px; padding: 10px;">
                            💰 Pago Recibido
                        </button>
                    </div>
                </div>

                <label>Modo de Visualización</label>
                <select name="link_mode">
                    <option value="landing">Landing Page (Directo)</option>
                    <option value="instructions">Instrucciones (Paso a paso)</option>
                </select>

                <div style="margin-top:20px;">
                    <button type="submit" class="btn primary">GENERAR SMART LINK</button>

                </div>
            </form>
        </div>
        </div>
    </main>

    <div id="modalBackdrop">
        <div class="modal">
            <h2 class="text-neon">✅ ¡LINK CREADO!</h2>
            <p>Acceso directo habilitado en:</p>
            <code id="modalLinkText"></code>
            <button onclick="location.reload()" class="btn primary">Aceptar</button>
        </div>
    </div>

    <script id="clients-json" type="application/json"><%- JSON.stringify(clients || []) %></script>

    <script>
        // --- Datos de Clientes ---
        const allClients = JSON.parse(document.getElementById('clients-json').textContent);
        const clientSearchInput = document.getElementById('clientSearch');
        const clientDropdown = document.getElementById('clientDropdown');
        const clientSelectedInfo = document.getElementById('clientSelectedInfo');
        const clientIdInput = document.getElementById('clientId');
        const newClientFields = document.getElementById('newClientFields');
        const newClientNameInput = document.getElementById('newClientName');
        const newClientContactInput = document.getElementById('newClientContact');

        // --- Buscador ---
        clientSearchInput.addEventListener('input', (e) => {
            const val = e.target.value.toLowerCase().trim();
            clientDropdown.innerHTML = '';

            if (!val) {
                clientDropdown.classList.add('hidden');
                newClientFields.classList.add('hidden');
                return;
            }

            const filtered = allClients.filter(c =>
                c.name.toLowerCase().includes(val) ||
                (c.telegram && c.telegram.toLowerCase().includes(val))
            );

            if (filtered.length > 0) {
                clientDropdown.classList.remove('hidden');
                filtered.forEach(c => {
                    const btn = document.createElement('button');
                    btn.type = 'button';
                    btn.className = 'client-item';
                    btn.textContent = `${c.name} (${c.telegram || 'Sin Telegram'})`;
                    btn.onclick = () => {
                        clientSearchInput.value = c.name;
                        clientIdInput.value = c.id;
                        clientSelectedInfo.textContent = `Seleccionado: ${c.name}`;
                        clientDropdown.classList.add('hidden');
                        newClientFields.classList.add('hidden');
                    };
                    clientDropdown.appendChild(btn);
                });
            } else {
                clientDropdown.classList.add('hidden');
                newClientFields.classList.remove('hidden');
                newClientNameInput.value = val;
                clientIdInput.value = '';
                clientSelectedInfo.textContent = 'Nuevo cliente: se creará al guardar.';
            }
        });

        // --- Lógica Pago (Día 23) ---
        document.getElementById('btnMarcarPagado').addEventListener('click', () => {
            const now = new Date();
            let month = now.getMonth();
            let year = now.getFullYear();
            if (now.getDate() >= 23) month++;
            const target = new Date(year, month, 23);
            document.getElementById('fechaVencimiento').value = target.toISOString().split('T')[0];
        });

        // --- Envío de Formulario ---
        const form = document.getElementById('genForm');
        form.addEventListener('submit', async (e) => {
            e.preventDefault();
            const formData = new FormData(form);
            try {
                const res = await fetch('/admin/save', { method: 'POST', body: formData, headers: { 'X-Requested-With': 'XMLHttpRequest' } });
                const result = await res.json();
                if (result.success) {
                    let domain = document.querySelector('#customDomain').value.trim() || window.location.host;

                    // Depuración: Ver qué estamos procesando
                    console.log('[LinkPro] Dominio original:', domain);

                    // Limpieza profunda: quitar protocolos, www opcional, y barras al final
                    domain = domain
                        .replace(/^https?:\/\//i, '') // Quita http:// o https://
                        .replace(/\/+$/, '')          // Quita barras al final
                        .trim();

                    console.log('[LinkPro] Dominio limpio:', domain);

                    const slug = document.querySelector('#slug').value.trim().replace(/^\/+/, '');
                    const finalLink = `${window.location.protocol}//${domain}/${slug}`;

                    document.querySelector('#modalLinkText').textContent = finalLink;
                    document.querySelector('#modalBackdrop').style.display = 'flex';
                } else {
                    alert('Error: ' + result.error);
                }
            } catch (err) { alert('Error de conexión'); }
        });


    </script>


</body>

</html>