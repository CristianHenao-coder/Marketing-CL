<div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 20px;">
    <div
        style="background: var(--card-bg); padding: 15px; border-radius: 12px; border: 1px solid var(--border); display: flex; gap: 20px; font-size: 13px;">
        <div><strong>ID:</strong> #<%= client.id %>
        </div>
        <div><strong>NOMBRE:</strong>
            <%= client.name %>
        </div>
        <div><strong>CONTACTO:</strong>
            <%= client.contact || client.telegram %>
        </div>
        <div style="margin-left: auto;"><strong>TOTAL:</strong> <span style="color: #00ff66;">$<%= client.total_money %>
                    USD</span></div>
    </div>
    <!-- Botón para añadir nuevo link -->
    <button onclick="openCreateLinkModal()" class="btn-glow" style="padding: 12px 20px; font-size: 14px;">+ Añadir Link
        a Cliente</button>
</div>


<div style="background: var(--card-bg); border: 1px solid var(--border); border-radius: 15px; overflow-x: auto;">
    <table style="width: 100%; border-collapse: collapse; white-space: nowrap;">
        <thead>
            <tr style="background: rgba(255,255,255,0.02); text-align: left; font-size: 12px; color: var(--primary);">
                <th style="padding: 15px;">FOTO / ID</th>
                <th style="padding: 15px;">CONFIGURACIÓN (OF/IG)</th>
                <th style="padding: 15px;">PRECIO</th>
                <th style="padding: 15px;">ANALYTICS</th>
                <th style="padding: 15px;">VENCIMIENTO</th>
                <th style="padding: 15px; text-align: right;">ACCIONES</th>
            </tr>
        </thead>
        <tbody>
            <% (client.smart_links || []).forEach(link=> { %>
                <tr style="border-bottom: 1px solid var(--border); font-size: 13px;">
                    <td style="padding: 15px;">
                        <div style="display: flex; align-items: center; gap: 10px;">
                            <img src="<%= link.photo || '/img/default.png' %>"
                                style="width: 35px; height: 35px; border-radius: 5px; object-fit: cover;">
                            <div>
                                <div style="font-weight: bold;">ID: <%= link.id %>
                                </div>
                                <div style="color: var(--text-dim); font-size: 11px;">/<%= link.slug %>
                                </div>
                            </div>
                        </div>
                    </td>

                    <td style="padding: 15px;">
                        <div style="color: #00ff66;">OF: <span style="color: white;">
                                <%= link.onlyfans || '—' %>
                            </span></div>
                        <div style="color: #e1306c;">IG: <span style="color: white;">
                                <%= link.instagram || '—' %>
                            </span></div>
                        <div style="margin-top: 8px; display: flex; gap: 5px; flex-wrap: wrap;">
                            <% if (link.advanced_config?.meta_shield !==false) { %>
                                <span title="Meta Shield Activo"
                                    style="background: rgba(225,48,108,0.15); border: 1px solid #e1306c44; color: #ff6ba8; font-size: 9px; font-weight: 700; padding: 2px 6px; border-radius: 3px; letter-spacing: 0.5px; text-transform: uppercase;">🛡️
                                    META</span>
                                <% } %>
                                    <% if (link.advanced_config?.tiktok_shield !==false) { %>
                                        <span title="TikTok Shield Activo"
                                            style="background: rgba(0,255,102,0.1); border: 1px solid #00ff6644; color: #00ff66; font-size: 9px; font-weight: 700; padding: 2px 6px; border-radius: 3px; letter-spacing: 0.5px; text-transform: uppercase;">🛡️
                                            TIKTOK</span>
                                        <% } %>
                                            <span title="Rotación de Telegram"
                                                style="background: rgba(0,136,204,0.1); border: 1px solid #0088cc44; color: #0088cc; font-size: 9px; font-weight: 700; padding: 2px 6px; border-radius: 3px; letter-spacing: 0.5px; text-transform: uppercase;">✈️
                                                BATCH: <%= link.telegram_rotation_limit || 200 %></span>
                        </div>
                    </td>

                    <td style="padding: 15px; font-weight: bold;">$<%= link.price || 30 %>
                    </td>

                    <td style="padding: 15px;">
                        <div style="background: #111; padding: 5px 10px; border-radius: 5px; display: inline-block;">
                            🖱️ <%= link.analytics?.total_clicks || 0 %> Clicks
                        </div>
                    </td>

                    <td style="padding: 15px;">
                        <%= link.fecha_vencimiento ? new Date(link.fecha_vencimiento).toLocaleDateString() : 'Sin fecha'
                            %>
                    </td>

                    <td style="padding: 15px; text-align: right;">
                        <div style="display: flex; gap: 5px; justify-content: flex-end;">
                            <!-- Botón Meta Shield -->
                            <button onclick="openMetaShieldModal('<%= link.slug %>')"
                                title="Meta Shield — Bypass Instagram/Threads"
                                style="background: linear-gradient(135deg, #e1306c, #833ab4); border: none; padding: 5px 10px; border-radius: 4px; cursor: pointer; color: white; font-weight: bold; font-size: 11px;">
                                🛡️ IG
                            </button>

                            <!-- Botón de Gestión de Telegram -->
                            <button onclick="openTelegramModal('<%= link.id %>', '<%= link.slug %>')"
                                style="background: #0088cc; border: 1px solid #0077b5; padding: 5px 10px; border-radius: 4px; cursor: pointer; color: white;">
                                ✈️ TG
                            </button>

                            <button onclick="openEditModal(this)" data-id="<%= link.id %>"
                                data-name="<%= link.display_name %>" data-price="<%= link.price %>"
                                data-expiry="<%= link.fecha_vencimiento ? link.fecha_vencimiento.split('T')[0] : '' %>"
                                data-ig="<%= link.instagram %>" data-of="<%= link.onlyfans %>"
                                data-tg-limit="<%= link.telegram_rotation_limit %>"
                                data-meta-shield="<%= link.advanced_config?.meta_shield || false %>"
                                data-tiktok-shield="<%= link.advanced_config?.tiktok_shield || false %>"
                                style="background: #222; border: 1px solid #444; padding: 5px 10px; border-radius: 4px; cursor: pointer;">
                                ✏️
                            </button>

                            <button onclick="toggleService('<%= link.id %>', '<%= link.status %>')"
                                style="background: <%= link.status === 'active' ? '#00ff66' : '#444' %>; color: <%= link.status === 'active' ? '#000' : '#fff' %>; border: none; padding: 5px 12px; border-radius: 4px; cursor: pointer; font-weight: bold;">
                                <%= link.status==='active' ? 'ON' : 'OFF' %>
                            </button>

                            <button onclick="deleteLink('<%= link.id %>')"
                                style="background: #411; border: none; padding: 5px 10px; border-radius: 4px; cursor: pointer;">🗑️</button>
                        </div>
                    </td>
                </tr>
                <% }) %>
        </tbody>
    </table>
</div>

<!-- MODAL DE CREACIÓN DE LINK (NUEVO) -->
<div id="createLinkModal"
    style="display: none; position: fixed; z-index: 1001; left: 0; top: 0; width: 100%; height: 100%; background-color: rgba(0,0,0,0.9); backdrop-filter: blur(8px); overflow-y: auto;">
    <div
        style="background-color: #0a0a0a; margin: 5% auto; padding: 30px; border: 1px solid var(--primary); width: 90%; max-width: 700px; border-radius: 15px;">
        <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 20px;">
            <h2 style="margin: 0; color: var(--primary);">🚀 Nuevo Link para <%= client.name %>
            </h2>
            <button onclick="closeCreateLinkModal()"
                style="background: none; border: none; color: #64748b; font-size: 24px; cursor: pointer;">&times;</button>
        </div>

        <form id="createLinkForm" enctype="multipart/form-data">
            <!-- Cliente pre-seleccionado y oculto -->
            <input type="hidden" name="client_id" value="<%= client.id %>">

            <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 20px;">
                <div>
                    <label>Slug (Ruta)</label>
                    <input type="text" name="slug" placeholder="ej: marta-vip-promo" required />
                </div>
                <div>
                    <label>Dominio Propio (Opcional)</label>
                    <input type="text" name="custom_domain" placeholder="ej: martavip.com" />
                </div>
            </div>

            <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 20px;">
                <div>
                    <label>Nombre en Pantalla</label>
                    <input type="text" name="display_name" required />
                </div>
                <div>
                    <label>Subtítulo</label>
                    <input type="text" name="subtitle" placeholder="Model / Artist" />
                </div>
            </div>

            <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 20px;">
                <div>
                    <label>OnlyFans URL</label>
                    <input type="url" name="onlyfans" />
                </div>
                <div>
                    <label>Instagram URL</label>
                    <input type="url" name="instagram" />
                </div>
            </div>

            <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 20px;">
                <div>
                    <label>Telegram URL</label>
                    <input type="url" name="telegram" placeholder="Link fijo o de respaldo" />
                </div>
                <div>
                    <label>Batch Rotación Telegram</label>
                    <input type="number" name="telegram_rotation_limit" value="1" min="1" />
                </div>
            </div>

            <div
                style="background: rgba(0,255,102,0.05); padding: 15px; border-radius: 10px; border: 1px solid #111; margin-top: 10px;">
                <label style="color: var(--primary); margin-bottom: 15px;">🛡️ ESCUDOS DE PROTECCIÓN</label>
                <div style="display: flex; gap: 20px;">
                    <label style="display: flex; align-items: center; gap: 8px; cursor: pointer; text-transform: none;">
                        <input type="checkbox" name="meta_shield" value="true" checked style="width: 15px; margin: 0;">
                        <span style="color: #fff; font-size: 12px; font-weight: 600;">Meta Shield</span>
                    </label>
                    <label style="display: flex; align-items: center; gap: 8px; cursor: pointer; text-transform: none;">
                        <input type="checkbox" name="tiktok_shield" value="true" checked
                            style="width: 15px; margin: 0;">
                        <span style="color: #fff; font-size: 12px; font-weight: 600;">TikTok Shield</span>
                    </label>
                </div>
            </div>

            <label>Foto de Perfil</label>
            <input type="file" name="file" accept="image/*" />

            <div style="margin-top: 20px;">
                <button type="submit" class="btn-glow" style="width: 100%;">Crear Link</button>
            </div>
        </form>
    </div>
</div>


<!-- MODAL DE EDICIÓN BÁSICA -->
<div id="editModal"
    style="display: none; position: fixed; z-index: 1000; left: 0; top: 0; width: 100%; height: 100%; background-color: rgba(0,0,0,0.8); backdrop-filter: blur(5px);">
    <div
        style="background-color: #0a0a0a; margin: 5% auto; padding: 25px; border: 1px solid var(--primary); width: 400px; border-radius: 15px; box-shadow: 0 0 20px rgba(0,255,102,0.2);">
        <h3 style="margin-top: 0; color: var(--primary);">EDITAR_LINK <span id="modalLinkId"
                style="color: var(--text-dim); font-size: 14px;"></span></h3>

        <form id="editForm" style="display: flex; flex-direction: column; gap: 15px;">
            <input type="hidden" id="edit_id">
            <div>
                <label
                    style="display: block; font-size: 12px; color: var(--text-dim); margin-bottom: 5px;">NOMBRE_DISPLAY</label>
                <input type="text" id="edit_name"
                    style="width: 100%; background: #1a1a1a; border: 1px solid #333; color: white; padding: 8px; border-radius: 5px;">
            </div>
            <div style="display: flex; gap: 10px;">
                <div style="flex: 1;">
                    <label style="display: block; font-size: 12px; color: var(--text-dim); margin-bottom: 5px;">PRECIO
                        ($)</label>
                    <input type="number" id="edit_price"
                        style="width: 100%; background: #1a1a1a; border: 1px solid #333; color: white; padding: 8px; border-radius: 5px;">
                </div>
                <div style="flex: 1;">
                    <label
                        style="display: block; font-size: 12px; color: var(--text-dim); margin-bottom: 5px;">VENCIMIENTO</label>
                    <input type="date" id="edit_expiry"
                        style="width: 100%; background: #1a1a1a; border: 1px solid #333; color: white; padding: 8px; border-radius: 5px;">
                </div>
            </div>
            <div>
                <label
                    style="display: block; font-size: 12px; color: var(--text-dim); margin-bottom: 5px;">INSTAGRAM</label>
                <input type="text" id="edit_ig"
                    style="width: 100%; background: #1a1a1a; border: 1px solid #333; color: white; padding: 8px; border-radius: 5px;">
            </div>
            <div>
                <label
                    style="display: block; font-size: 12px; color: var(--text-dim); margin-bottom: 5px;">ONLYFANS</label>
                <input type="text" id="edit_of"
                    style="width: 100%; background: #1a1a1a; border: 1px solid #333; color: white; padding: 8px; border-radius: 5px;">
            </div>
            <div>
                <label style="display: block; font-size: 12px; color: var(--text-dim); margin-bottom: 5px;">BATCH
                    ROTACIÓN TELEGRAM</label>
                <input type="number" id="edit_tg_limit"
                    style="width: 100%; background: #1a1a1a; border: 1px solid #333; color: white; padding: 8px; border-radius: 5px;">
            </div>

            <div style="background: rgba(225,48,108,0.05); padding: 10px; border-radius: 8px; border: 1px solid #222;">
                <div style="display: flex; gap: 15px;">
                    <label style="display: flex; align-items:center; gap:8px; cursor:pointer;">
                        <input type="checkbox" id="edit_meta_shield" style="width:16px;">
                        <span style="font-size:12px; color:#fff;">Meta Shield (IG)</span>
                    </label>
                    <label style="display: flex; align-items:center; gap:8px; cursor:pointer;">
                        <input type="checkbox" id="edit_tiktok_shield" style="width:16px;">
                        <span style="font-size:12px; color:#fff;">TikTok Shield</span>
                    </label>
                </div>
            </div>
            <div style="display: flex; gap: 10px; margin-top: 10px;">
                <button type="button" onclick="closeModal()"
                    style="flex: 1; padding: 10px; background: #222; color: white; border: none; border-radius: 5px; cursor: pointer;">CANCELAR</button>
                <button type="submit"
                    style="flex: 1; padding: 10px; background: var(--primary); color: black; border: none; border-radius: 5px; cursor: pointer; font-weight: bold;">GUARDAR</button>
            </div>
        </form>
    </div>
</div>

<!-- MODAL DE GESTIÓN DE TELEGRAM -->
<div id="telegramModal"
    style="display: none; position: fixed; z-index: 1000; left: 0; top: 0; width: 100%; height: 100%; background-color: rgba(0,0,0,0.9); backdrop-filter: blur(5px); overflow-y: auto;">
    <div
        style="background-color: #0f172a; margin: 5% auto; padding: 30px; border: 1px solid #0088cc; width: 90%; max-width: 800px; border-radius: 15px; box-shadow: 0 0 30px rgba(0,136,204,0.3);">

        <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 20px;">
            <h2 style="margin: 0; color: #0088cc;">Gestión de Telegram <span id="tgModalSlug"
                    style="color: #64748b; font-size: 16px;"></span></h2>
            <button onclick="closeTelegramModal()"
                style="background: none; border: none; color: #64748b; font-size: 24px; cursor: pointer;">&times;</button>
        </div>

        <div style="display: grid; grid-template-columns: 1fr 1fr 1fr; gap: 20px; margin-bottom: 20px;">
            <!-- Panel de Control -->
            <div style="background: #1e293b; padding: 20px; border-radius: 10px; border: 1px solid #334155;">
                <p style="color: #94a3b8; font-size: 12px; margin-top: 0;">CONTROL DE TRÁFICO</p>
                <div style="display: flex; gap: 10px;">
                    <button onclick="addBot()"
                        style="background: #0088cc; color: white; border: none; padding: 8px 15px; border-radius: 6px; cursor: pointer; font-weight: bold;">+
                        Añadir Bot</button>
                    <button onclick="resetStats()"
                        style="background: #334155; color: white; border: none; padding: 8px 15px; border-radius: 6px; cursor: pointer;">Reset
                        Clics</button>
                </div>
            </div>

            <!-- Panel de Límite Rotación -->
            <div style="background: #1e293b; padding: 20px; border-radius: 10px; border: 1px solid #334155;">
                <p style="color: #94a3b8; font-size: 12px; margin-top: 0;">LÍMITE DE ROTACIÓN</p>
                <div style="display: flex; align-items: center; gap: 15px;">
                    <span id="limitDisplay" style="font-size: 24px; font-weight: bold; color: #0088cc;">--</span>
                    <button onclick="updateLimit()"
                        style="background: #334155; color: white; border: none; padding: 5px 10px; border-radius: 4px; cursor: pointer; font-size: 12px;">Cambiar</button>
                </div>
            </div>

            <!-- Panel de Capacidad Máxima -->
            <div style="background: #1e293b; padding: 20px; border-radius: 10px; border: 1px solid #334155;">
                <p style="color: #94a3b8; font-size: 12px; margin-top: 0;">CAPACIDAD MÁXIMA (VIDA ÚTIL)</p>
                <div style="display: flex; align-items: center; gap: 15px;">
                    <span id="capacityDisplay" style="font-size: 24px; font-weight: bold; color: #ef4444;">--</span>
                    <button onclick="updateCapacity()"
                        style="background: #334155; color: white; border: none; padding: 5px 10px; border-radius: 4px; cursor: pointer; font-size: 12px;">Cambiar</button>
                </div>
            </div>
        </div>

        <!-- Tabla de Bots -->
        <div style="background: #1e293b; border-radius: 10px; overflow: hidden; border: 1px solid #334155;">
            <table style="width: 100%; border-collapse: collapse; text-align: left;">
                <thead style="background: #0f172a; color: #94a3b8; font-size: 12px; text-transform: uppercase;">
                    <tr>
                        <th style="padding: 15px;">Bot Telegram</th>
                        <th style="padding: 15px;">Progreso</th>
                        <th style="padding: 15px;">Estado</th>
                        <th style="padding: 15px; text-align: center;">Acciones</th>
                    </tr>
                </thead>
                <tbody id="botTableBody">
                    <!-- Se llena dinámicamente -->
                </tbody>
            </table>
        </div>
    </div>
</div>

<script>
    // --- VARIABLES GLOBALES PARA EL MODAL DE TELEGRAM ---
    let currentLinkId = null;

    // --- FUNCIONES DE CREACIÓN DE LINK (NUEVO) ---
    function openCreateLinkModal() {
        document.getElementById('createLinkModal').style.display = 'block';
    }
    function closeCreateLinkModal() {
        document.getElementById('createLinkModal').style.display = 'none';
    }

    // --- FUNCIONES DE EDICIÓN BÁSICA ---
    function openEditModal(button) {
        const data = button.dataset;
        document.getElementById('edit_id').value = data.id;
        document.getElementById('modalLinkId').innerText = `#${data.id}`;
        document.getElementById('edit_name').value = data.name;
        document.getElementById('edit_price').value = data.price;
        document.getElementById('edit_expiry').value = data.expiry;
        document.getElementById('edit_ig').value = data.ig;
        document.getElementById('edit_of').value = data.of;
        document.getElementById('edit_tg_limit').value = data.tgLimit || 200;
        document.getElementById('edit_meta_shield').checked = data.metaShield === 'true';
        document.getElementById('edit_tiktok_shield').checked = data.tiktokShield === 'true';
        document.getElementById('editModal').style.display = 'block';
    }

    function closeModal() {
        document.getElementById('editModal').style.display = 'none';
    }

    // --- FUNCIONES DE GESTIÓN DE TELEGRAM ---

    async function openTelegramModal(linkId, slug) {
        currentLinkId = linkId;
        document.getElementById('tgModalSlug').innerText = `(${slug})`;
        document.getElementById('telegramModal').style.display = 'block';
        await loadBots();
    }

    function closeTelegramModal() {
        document.getElementById('telegramModal').style.display = 'none';
        currentLinkId = null;
    }

    async function loadBots() {
        if (!currentLinkId) return;

        try {
            const res = await fetch(`/admin/telegram/status/${currentLinkId}`);
            const data = await res.json();

            document.getElementById('limitDisplay').innerText = (data.limit || 200) + " personas";
            document.getElementById('capacityDisplay').innerText = (data.max_capacity || 2000) + " total";

            const tbody = document.getElementById('botTableBody');
            tbody.innerHTML = '';

            if (data.stats && data.stats.length > 0) {
                data.stats.forEach(bot => {
                    // Calculamos porcentaje basado en la capacidad máxima (vida útil)
                    const percent = Math.min((bot.clicks / (data.max_capacity || 2000)) * 100, 100);
                    const row = document.createElement('tr');
                    row.style.borderBottom = '1px solid #334155';

                    // Estados visuales
                    if (bot.is_full) {
                        row.style.background = 'rgba(239, 68, 68, 0.1)'; // Rojo (Lleno)
                    } else if (bot.active) {
                        row.style.background = 'rgba(74, 222, 128, 0.1)'; // Verde (Activo)
                    }

                    row.innerHTML = `
                        <td style="padding: 15px; color: #f472b6; font-family: monospace;">${bot.url}</td>
                        <td style="padding: 15px; width: 30%;">
                            <div style="width: 100%; background: #334155; height: 8px; border-radius: 4px; margin-bottom: 5px;">
                                <div style="background: ${bot.is_full ? '#ef4444' : '#ec4899'}; height: 100%; width: ${percent}%; border-radius: 4px;"></div>
                            </div>
                            <div style="font-size: 10px; color: #94a3b8; font-weight: bold;">${bot.clicks} / ${data.max_capacity || 2000} total</div>
                        </td>
                        <td style="padding: 15px;">
                            ${bot.is_full
                            ? '<span style="color: #ef4444; font-size: 10px; font-weight: bold; border: 1px solid rgba(239, 68, 68, 0.3); padding: 2px 6px; border-radius: 4px;">LLENO</span>'
                            : (bot.active
                                ? '<span style="color: #4ade80; font-size: 10px; font-weight: bold; border: 1px solid rgba(74, 222, 128, 0.3); padding: 2px 6px; border-radius: 4px;">ACTIVO</span>'
                                : '<span style="color: #64748b; font-size: 10px;">EN COLA</span>')
                        }
                        </td>
                        <td style="padding: 15px; text-align: center;">
                            <button onclick="editBot('${bot.id}', '${bot.url}')" style="background: none; border: none; color: #94a3b8; cursor: pointer; margin-right: 10px;">✏️</button>
                            <button onclick="deleteBot('${bot.id}')" style="background: none; border: none; color: #ef4444; cursor: pointer;">🗑️</button>
                        </td>
                    `;
                    tbody.appendChild(row);
                });
            } else {
                tbody.innerHTML = '<tr><td colspan="4" style="padding: 20px; text-align: center; color: #64748b;">No hay bots configurados.</td></tr>';
            }

        } catch (err) {
            console.error("Error cargando bots:", err);
            alert("Error al cargar datos de Telegram");
        }
    }

    async function addBot() {
        const url = prompt("Link de Telegram (ej: https://t.me/mibot):");
        if (url) {
            await fetch(`/admin/telegram/add/${currentLinkId}`, {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ url })
            });
            loadBots();
        }
    }

    async function editBot(botId, oldUrl) {
        const newUrl = prompt("Nueva URL del Bot:", oldUrl);
        if (newUrl && newUrl !== oldUrl) {
            await fetch(`/admin/telegram/edit/${botId}`, {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ url: newUrl })
            });
            loadBots();
        }
    }

    async function deleteBot(botId) {
        if (confirm("¿Eliminar este bot?")) {
            await fetch(`/admin/telegram/delete/${botId}`, { method: 'DELETE' });
            loadBots();
        }
    }

    async function updateLimit() {
        const val = prompt("Nuevo límite de rotación (Batch):");
        if (val && !isNaN(val)) {
            await fetch(`/admin/telegram/limit/${currentLinkId}`, {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ limit: parseInt(val) })
            });
            loadBots();
        }
    }

    async function updateCapacity() {
        const val = prompt("Nueva capacidad máxima (Vida Útil):");
        if (val && !isNaN(val)) {
            await fetch(`/admin/telegram/capacity/${currentLinkId}`, {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ max_capacity: parseInt(val) })
            });
            loadBots();
        }
    }

    async function resetStats() {
        if (confirm("¿Poner a 0 los clics de este link?")) {
            await fetch(`/admin/telegram/reset/${currentLinkId}`, { method: 'POST' });
            loadBots();
        }
    }

    // ✅ ENCENDER / APAGAR SERVICIO (status active <-> pending_payment)
    async function toggleService(id, currentStatus) {
        try {
            const response = await fetch(`/admin/links/toggle/${id}`, {
                method: "POST",
                headers: { "Content-Type": "application/json" },
                body: JSON.stringify({ currentStatus }),
            });

            const result = await response.json();

            if (result.success) {
                alert(`Estado cambiado ✅ Ahora está: ${result.newStatus}`);
                location.reload(); // recarga para que cambie el botón ON/OFF
            } else {
                alert("Error: " + result.error);
            }
        } catch (error) {
            console.error("toggleService error:", error);
            alert("Error de conexión ❌");
        }
    }

    // ✅ ELIMINAR LINK
    async function deleteLink(id) {
        const confirmDelete = confirm("¿Seguro que deseas eliminar este link? 🗑️");
        if (!confirmDelete) return;

        try {
            const response = await fetch(`/admin/links/${id}`, {
                method: "DELETE",
            });

            const result = await response.json();

            if (result.success) {
                alert("Link eliminado ✅");
                location.reload();
            } else {
                alert("Error: " + result.error);
            }
        } catch (error) {
            console.error("deleteLink error:", error);
            alert("Error de conexión ❌");
        }
    }

    // Cerrar modal si se hace clic fuera de la caja
    window.onclick = function (event) {
        const modal = document.getElementById('editModal');
        const tgModal = document.getElementById('telegramModal');
        const createModal = document.getElementById('createLinkModal');
        if (event.target == modal) closeModal();
        if (event.target == tgModal) closeTelegramModal();
        if (event.target == createModal) closeCreateLinkModal();
    }

    // Capturar el envío del formulario de edición
    document.getElementById('editForm').addEventListener('submit', async (e) => {
        e.preventDefault();
        const id = document.getElementById('edit_id').value;
        const rawExpiry = document.getElementById('edit_expiry').value;
        const finalExpiry = rawExpiry === "" ? null : rawExpiry;
        const formData = {
            display_name: document.getElementById('edit_name').value,
            price: parseFloat(document.getElementById('edit_price').value) || 0,
            instagram: document.getElementById('edit_ig').value,
            onlyfans: document.getElementById('edit_of').value,
            telegram_rotation_limit: parseInt(document.getElementById('edit_tg_limit').value) || 200,
            meta_shield: document.getElementById('edit_meta_shield').checked,
            tiktok_shield: document.getElementById('edit_tiktok_shield').checked
        };

        try {
            const response = await fetch(`/admin/links/edit/${id}`, {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify(formData)
            });
            const result = await response.json();
            if (result.success) {
                alert('¡Link actualizado! ✅');
                location.reload();
            } else {
                alert('Error del servidor: ' + result.error);
            }
        } catch (error) {
            console.error('Error en fetch:', error);
            alert('Hubo un error de conexión ❌');
        }
    });

    // Capturar el envío del formulario de CREACIÓN
    document.getElementById('createLinkForm').addEventListener('submit', async (e) => {
        e.preventDefault();
        const formData = new FormData(e.target);
        try {
            const res = await fetch('/admin/save', { method: 'POST', body: formData });
            const result = await res.json();
            if (result.success) {
                alert('¡Nuevo link creado para este cliente! ✅');
                location.reload();
            } else {
                alert('Error al crear el link: ' + result.error);
            }
        } catch (err) {
            alert('Error de conexión al crear el link.');
        }
    });
</script>

