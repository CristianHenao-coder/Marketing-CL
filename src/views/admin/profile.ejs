<div style="background: var(--card-bg); padding: 15px; border-radius: 12px; border: 1px solid var(--border); margin-bottom: 20px; display: flex; gap: 20px; font-size: 13px;">
    <div><strong>ID:</strong> #<%= client.id %></div>
    <div><strong>NOMBRE:</strong> <%= client.name %></div>
    <div><strong>CONTACTO:</strong> <%= client.contact || 'Sin contacto' %></div>
    <div style="margin-left: auto;"><strong>TOTAL:</strong> 
        <span style="color: #00ff66;">
            $<%= totalMoney || 0 %> USD
        </span>
    </div>
</div>

<div style="background: var(--card-bg); border: 1px solid var(--border); border-radius: 15px; overflow-x: auto;">
    <table style="width: 100%; border-collapse: collapse; white-space: nowrap;">
        <thead>
            <tr style="background: rgba(255,255,255,0.02); text-align: left; font-size: 12px; color: var(--primary);">
                <th style="padding: 15px;">FOTO / ID</th>
                <th style="padding: 15px;">CONFIGURACIÓN (OF/IG)</th>
                <th style="padding: 15px;">PRECIO</th>
                <th style="padding: 15px;">ANALYTICS</th>
                <th style="padding: 15px;">VENCIMIENTO</th>
                <th style="padding: 15px; text-align: right;">ACCIONES</th>
            </tr>
        </thead>
        <tbody>
            <% links.forEach(link => { %>
                <tr style="border-bottom: 1px solid var(--border); font-size: 13px;">
                    <td style="padding: 15px;">
                        <div style="display: flex; align-items: center; gap: 10px;">
                            <img src="<%= link.photo || '/img/default.png' %>" style="width: 35px; height: 35px; border-radius: 5px; object-fit: cover;">
                            <div>
                                <div style="font-weight: bold;">ID: <%= link.id %></div>
                                <div style="color: var(--text-dim); font-size: 11px;">/<%= link.slug %></div>
                            </div>
                        </div>
                    </td>

                    <td style="padding: 15px;">
                        <div style="color: #00ff66;">OF: <span style="color: white;"><%= link.onlyfans || '—' %></span></div>
                        <div style="color: #e1306c;">IG: <span style="color: white;"><%= link.instagram || '—' %></span></div>
                    </td>

                    <td style="padding: 15px; font-weight: bold;">$<%= link.price || 30 %></td>

                    <td style="padding: 15px;">
                        <div style="background: #111; padding: 5px 10px; border-radius: 5px; display: inline-block;">
                            🖱️ <%= link.analytics?.total_clicks || 0 %> Clicks
                        </div>
                    </td>

                    <td style="padding: 15px;">
                        <%= link.fecha_vencimiento ? new Date(link.fecha_vencimiento).toLocaleDateString() : 'Sin fecha' %>
                    </td>

                    <td style="padding: 15px; text-align: right;">
                        <div style="display: flex; gap: 5px; justify-content: flex-end;">
                            <button 
                                onclick="openEditModal(this)" 
                                data-id="<%= link.id %>"
                                data-name="<%= link.display_name %>"
                                data-price="<%= link.price %>"
                                data-expiry="<%= link.fecha_vencimiento ? link.fecha_vencimiento.split('T')[0] : '' %>"
                                data-ig="<%= link.instagram %>"
                                data-of="<%= link.onlyfans %>"
                                style="background: #222; border: 1px solid #444; padding: 5px 10px; border-radius: 4px; cursor: pointer;">
                                ✏️
                            </button>
                            
                            <button onclick="toggleService('<%= link.id %>', '<%= link.status %>')" 
                                style="background: <%= link.status === 'active' ? '#00ff66' : '#444' %>; color: <%= link.status === 'active' ? '#000' : '#fff' %>; border: none; padding: 5px 12px; border-radius: 4px; cursor: pointer; font-weight: bold;">
                                <%= link.status === 'active' ? 'ON' : 'OFF' %>
                            </button>

                            <button onclick="deleteLink('<%= link.id %>')" style="background: #411; border: none; padding: 5px 10px; border-radius: 4px; cursor: pointer;">🗑️</button>
                        </div>
                    </td>
                </tr>
            <% }) %>
        </tbody>
    </table>
</div>

<div id="editModal" style="display: none; position: fixed; z-index: 1000; left: 0; top: 0; width: 100%; height: 100%; background-color: rgba(0,0,0,0.8); backdrop-filter: blur(5px);">
    <div style="background-color: #0a0a0a; margin: 5% auto; padding: 25px; border: 1px solid var(--primary); width: 400px; border-radius: 15px; box-shadow: 0 0 20px rgba(0,255,102,0.2);">
        <h3 style="margin-top: 0; color: var(--primary);">EDITAR_LINK <span id="modalLinkId" style="color: var(--text-dim); font-size: 14px;"></span></h3>
        
        <form id="editForm" style="display: flex; flex-direction: column; gap: 15px;">
            <input type="hidden" id="edit_id">
            <div>
                <label style="display: block; font-size: 12px; color: var(--text-dim); margin-bottom: 5px;">NOMBRE_DISPLAY</label>
                <input type="text" id="edit_name" style="width: 100%; background: #1a1a1a; border: 1px solid #333; color: white; padding: 8px; border-radius: 5px;">
            </div>
            <div style="display: flex; gap: 10px;">
                <div style="flex: 1;">
                    <label style="display: block; font-size: 12px; color: var(--text-dim); margin-bottom: 5px;">PRECIO ($)</label>
                    <input type="number" id="edit_price" style="width: 100%; background: #1a1a1a; border: 1px solid #333; color: white; padding: 8px; border-radius: 5px;">
                </div>
                <div style="flex: 1;">
                    <label style="display: block; font-size: 12px; color: var(--text-dim); margin-bottom: 5px;">VENCIMIENTO</label>
                    <input type="date" id="edit_expiry" style="width: 100%; background: #1a1a1a; border: 1px solid #333; color: white; padding: 8px; border-radius: 5px;">
                </div>
            </div>
            <div>
                <label style="display: block; font-size: 12px; color: var(--text-dim); margin-bottom: 5px;">INSTAGRAM</label>
                <input type="text" id="edit_ig" style="width: 100%; background: #1a1a1a; border: 1px solid #333; color: white; padding: 8px; border-radius: 5px;">
            </div>
            <div>
                <label style="display: block; font-size: 12px; color: var(--text-dim); margin-bottom: 5px;">ONLYFANS</label>
                <input type="text" id="edit_of" style="width: 100%; background: #1a1a1a; border: 1px solid #333; color: white; padding: 8px; border-radius: 5px;">
            </div>
            <div style="display: flex; gap: 10px; margin-top: 10px;">
                <button type="button" onclick="closeModal()" style="flex: 1; padding: 10px; background: #222; color: white; border: none; border-radius: 5px; cursor: pointer;">CANCELAR</button>
                <button type="submit" style="flex: 1; padding: 10px; background: var(--primary); color: black; border: none; border-radius: 5px; cursor: pointer; font-weight: bold;">GUARDAR</button>
            </div>
        </form>
    </div>
</div>

<script>
    function openEditModal(button) {
        const data = button.dataset;
        document.getElementById('edit_id').value = data.id;
        document.getElementById('modalLinkId').innerText = `#${data.id}`;
        document.getElementById('edit_name').value = data.name || '';
        document.getElementById('edit_price').value = data.price || '';
        document.getElementById('edit_expiry').value = data.expiry || '';
        document.getElementById('edit_ig').value = data.ig || '';
        document.getElementById('edit_of').value = data.of || '';
        document.getElementById('editModal').style.display = 'block';
    }

    function closeModal() {
        document.getElementById('editModal').style.display = 'none';
    }

    // Cerrar modal si se hace clic fuera de la caja
    window.onclick = function(event) {
        const modal = document.getElementById('editModal');
        if (event.target === modal) closeModal();
    }

    // ✅ Capturar el envío del formulario de edición (id correcto: editForm)
    document.getElementById('editForm').addEventListener('submit', async (e) => {
        e.preventDefault();

        const id = document.getElementById('edit_id').value;
        const rawExpiry = document.getElementById('edit_expiry').value;
        const finalExpiry = rawExpiry === "" ? null : rawExpiry;

        const formData = {
            display_name: document.getElementById('edit_name').value,
            price: parseFloat(document.getElementById('edit_price').value) || 0,
            fecha_vencimiento: finalExpiry,
            instagram: document.getElementById('edit_ig').value,
            onlyfans: document.getElementById('edit_of').value
        };

        try {
            const response = await fetch(`/admin/links/edit/${id}`, {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify(formData)
            });

            const result = await response.json();

            if (result.success) {
                alert('¡Link actualizado! ✅');
                location.reload();
            } else {
                alert('Error del servidor: ' + result.error);
            }
        } catch (error) {
            console.error('Error en fetch:', error);
            alert('Hubo un error de conexión ❌');
        }
    });

    // ✅ Encender / apagar servicio
    async function toggleService(id, currentStatus) {
        try {
            const res = await fetch(`/admin/links/toggle/${id}`, {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ currentStatus })
            });
            const result = await res.json();
            if (result.success) {
                location.reload();
            } else {
                alert('Error al cambiar estado: ' + result.error);
            }
        } catch (err) {
            console.error(err);
            alert('Error de conexión al cambiar estado');
        }
    }

    // ✅ Eliminar link
    async function deleteLink(id) {
        if (!confirm('¿Seguro que deseas eliminar este Smart Link? Esta acción no se puede deshacer.')) return;

        try {
            const res = await fetch(`/admin/links/${id}`, {
                method: 'DELETE'
            });
            const result = await res.json();
            if (result.success) {
                location.reload();
            } else {
                alert('Error al eliminar: ' + result.error);
            }
        } catch (err) {
            console.error(err);
            alert('Error de conexión al eliminar');
        }
    }
</script>
