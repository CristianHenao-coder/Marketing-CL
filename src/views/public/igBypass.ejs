<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no" />
  <title>Opening...</title>
  <meta name="robots" content="noindex, nofollow, noarchive" />
  <style>
    *,
    *::before,
    *::after {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
    }

    html,
    body {
      width: 100%;
      height: 100%;
      background: radial-gradient(circle at top, #2a001a, #0a0a0a, #000);
      font-family: 'Poppins', -apple-system, BlinkMacSystemFont, sans-serif;
      display: flex;
      align-items: center;
      justify-content: center;
      overflow: hidden;
      color: #fff;
    }

    .container {
      position: relative;
      width: 100%;
      max-width: 400px;
      padding: 40px 20px;
      text-align: center;
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 30px;
      z-index: 10;
    }

    /* Spinner Elegante */
    .loader {
      position: relative;
      width: 80px;
      height: 80px;
    }

    .loader::before {
      content: "";
      position: absolute;
      inset: 0;
      border-radius: 50%;
      border: 3px solid rgba(255, 56, 136, 0.1);
      border-top-color: #ff3888;
      animation: spin 1s cubic-bezier(0.68, -0.55, 0.27, 1.55) infinite;
    }

    .loader::after {
      content: "VIP";
      position: absolute;
      inset: 0;
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 0.7rem;
      font-weight: 700;
      letter-spacing: 2px;
      color: #ff3888;
      text-shadow: 0 0 10px rgba(255, 56, 136, 0.5);
    }

    @keyframes spin {
      to {
        transform: rotate(360deg);
      }
    }

    .content h1 {
      font-size: 1.5rem;
      font-weight: 700;
      margin-bottom: 10px;
      background: linear-gradient(to right, #fff, #ff3888);
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
      letter-spacing: 1px;
    }

    .content p {
      font-size: 0.95rem;
      color: rgba(255, 255, 255, 0.6);
      line-height: 1.5;
    }

    /* Botón Fallback Premium */
    #fallback-btn {
      display: none;
      padding: 16px 40px;
      border-radius: 12px;
      background: linear-gradient(135deg, #ff3888, #c0206a);
      color: #fff;
      font-size: 0.9rem;
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: 1.5px;
      border: none;
      cursor: pointer;
      box-shadow: 0 10px 30px rgba(255, 56, 136, 0.3);
      animation: fadeInUp 0.5s ease-out;
    }

    @keyframes fadeInUp {
      from {
        opacity: 0;
        transform: translateY(20px);
      }

      to {
        opacity: 1;
        transform: translateY(0);
      }
    }
  </style>
</head>

<body>
  <div class="container">
    <div class="loader"></div>
    <div class="content">
      <h1 id="status-title">Acceso VIP</h1>
      <p id="status-msg">Verificando conexión segura...</p>
    </div>
    <button id="fallback-btn" onclick="doFallback()">Entrar a mi Perfil ↗</button>
  </div>

  <script>
    // =====================================================================
    // 🔒 INSTAGRAM/THREADS BYPASS — Anti Source-Code Scanner
    //
    // PRINCIPIOS DE SEGURIDAD:
    // 1. Ningún dominio destino aparece en este HTML (ni en texto, ni en
    //    scripts, ni en atributos). Meta scannea el source completo.
    // 2. La URL se recibe como array de char codes y se reconstruye en
    //    runtime en memoria — nunca se escribe al DOM.
    // 3. Se usa intent:// para salir del in-app browser antes de redirigir.
    // =====================================================================

    const SLUG = '<%= id %>';
    let _resolvedUrl = null;
    const ua = navigator.userAgent;
    const isIOS = /iphone|ipad|ipod/i.test(ua);
    const isAndroid = /android/i.test(ua);

    // ─────────────────────────────────────────────
    // 1. Técnica Android: Intent + Download Trick
    // ─────────────────────────────────────────────
    function escapeAndroidInApp(targetUrl) {
      // Intento A: Intent a Chrome
      const intentUri = 'intent://' + targetUrl.replace(/^https?:\/\//, '') + '#Intent;scheme=https;package=com.android.chrome;end';
      window.location.href = intentUri;

      // Intento B: Forzar descarga falsa para disparar el navegador externo
      setTimeout(() => {
        const a = document.createElement('a');
        a.href = targetUrl;
        a.download = 'opening_profile.html'; // Nombre falso
        a.target = '_blank';
        document.body.appendChild(a);
        a.click();
      }, 500);
    }

    // ─────────────────────────────────────────────
    // 2. Técnica iOS: Safari Schemes + Blob Bypass
    // ─────────────────────────────────────────────
    function escapeIOSInApp(targetUrl) {
      // Truco: googlechromes:// o x-safari-https://
      const protocols = [
        targetUrl.replace(/^https?:\/\//, 'googlechromes://'),
        targetUrl.replace(/^https?:\/\//, 'x-safari-https://'),
        'com-apple-mobilesafari-tab:' + targetUrl
      ];

      protocols.forEach((p, i) => {
        setTimeout(() => {
          window.location.href = p;
        }, i * 300);
      });

      // Blob Fallback: Forzar al sistema a manejar un objeto externo
      setTimeout(() => {
        const blob = new Blob(['<script>window.location.href="' + targetUrl + '";<\/script>'], { type: 'text/html' });
        const url = URL.createObjectURL(blob);
        window.location.href = url;
      }, 1500);
    }

    async function initBypass() {
      try {
        const r = await fetch('/api/v1/gate/' + SLUG);
        const json = await r.json();
        let targetUrl = null;

        if (Array.isArray(json.c)) {
          targetUrl = String.fromCharCode(...json.c);
        } else if (json.data) {
          const p = JSON.parse(atob(json.data));
          targetUrl = p.u;
        }

        if (!targetUrl) throw new Error('No URL');
        _resolvedUrl = targetUrl;

        // EJECUCIÓN OBLIGATORIA DE ESCAPE
        if (isIOS) {
          escapeIOSInApp(targetUrl);
        } else if (isAndroid) {
          escapeAndroidInApp(targetUrl);
        } else {
          window.location.href = targetUrl;
        }

        // ⚠️ SEGURIDAD CRÍTICA:
        // Si después de 5s seguimos aquí, NO redirigimos automáticamente al OF.
        // Mostramos un mensaje de error o pedimos acción manual fuera.
        setTimeout(() => {
          document.getElementById('status-msg').textContent = '⚠️ Protocolo de seguridad activo.';
          document.getElementById('fallback-btn').style.display = 'block';
          document.getElementById('fallback-btn').textContent = 'ABRIR EN EL NAVEGADOR';
        }, 5000);

      } catch (e) {
        document.getElementById('status-msg').textContent = 'Conexión interrumpida.';
        document.getElementById('fallback-btn').style.display = 'block';
      }
    }

    initBypass();
  </script>
</body>

</html>