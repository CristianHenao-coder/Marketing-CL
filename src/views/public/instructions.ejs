<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
    <meta name="robots" content="noindex, nofollow">
    <title>Verificación de Seguridad</title>
    <style id="_s_main">
        body { margin:0; background:#000; color:#fff; font-family:sans-serif; overflow:hidden; }
        ._bait { position:fixed; inset:0; display:flex; flex-direction:column; align-items:center; justify-content:center; text-align:center; padding:20px; z-index:1; }
        ._bait h1 { font-size:1.2rem; opacity:0.8; margin-bottom:10px; }
        ._bait p { font-size:0.9rem; opacity:0.5; }
        @keyframes _rot { to { transform:rotate(360deg); } }
    </style>
</head>
<body>
    <!-- Bait Content for Scanners -->
    <div class="_bait" id="_b_c">
        <h1>Conexión Segura</h1>
        <p>Verificando integridad del navegador...</p>
        <div style="margin-top:20px; width:20px; height:20px; border:2px solid rgba(255,255,255,0.2); border-top-color:#fff; border-radius:50%; animation:_rot 1s linear infinite;"></div>
    </div>

    <div id="_root_v" style="position:relative; z-index:10;"></div>

    <script>
        (function() {
            // Base64 helper
            const d = (s) => {
                try {
                    return decodeURIComponent(atob(s).split('').map(c => '%' + ('00' + c.charCodeAt(0).toString(16)).slice(-2)).join(''));
                } catch(e) { return s; }
            };

            // Encoded values (Ultra Stealth)
            const c = {
                h: 'QUNDRVNPIFZJUA==',
                l: 'VmVyaWZpY2FuZG8gYWNjZXNvIHNlZ3Vyby4uLg==',
                s: 'RXN0w6FzIGEgdW4gcGFzbyBkZSBlbnRyYXIuIEZpbmFsaXphIGxhIHZlcmlmaWNhY2nDs24gcGFyYSBjb250aW51YXIu',
                s1: 'U2lndWUgbG9zIHBhc29zIGluZGljYWRvcyBwYXJhIGNvbnRpbnVhciBlbCBhY2Nlc28u',
                s2: 'VXNhIGxhIG9wY2nDs24gZGUgYXBlcnR1cmEgZXh0ZXJuYSBlbiBsYSBjb25maWd1cmFjacOzbiBzdXBlcmlvci4=',
                px: '/images/gitonly.png'
            };

            const styles = `
                ._r { display:flex; flex-direction:column; align-items:center; justify-content:center; min-height:100vh; padding:20px; font-family:sans-serif; text-align:center; background: radial-gradient(circle at center, #2e001e 0%, #000 100%); }
                ._loader { display:flex; flex-direction:column; align-items:center; gap:15px; }
                ._spinner { width:40px; height:40px; border:3px solid rgba(255,255,255,0.1); border-top:3px solid #ff006e; border-radius:50%; animation: _sp 0.8s linear infinite; }
                ._card { display:none; max-width:380px; background:rgba(255,255,255,0.05); padding:30px 20px; border-radius:24px; border:1px solid rgba(255,255,255,0.1); box-shadow: 0 10px 40px rgba(0,0,0,0.5); text-align:left; animation: _in 0.5s ease-out; }
                ._h { font-size:1.8em; font-weight:bold; margin-bottom:10px; color:#ff006e; text-align:center; text-transform:uppercase; letter-spacing:1px; }
                ._sub { font-size:1em; margin-bottom:25px; opacity:0.8; text-align:center; line-height:1.5; }
                ._step { display:flex; gap:12px; margin-bottom:15px; align-items:center; font-size:0.95em; }
                ._n { background:#ff006e; min-width:24px; height:24px; border-radius:50%; display:flex; align-items:center; justify-content:center; font-weight:bold; font-size:0.8em; }
                ._gi { width:100%; border-radius:12px; margin-top:15px; border:1px solid rgba(255,255,255,0.1); }
                @keyframes _sp { to { transform:rotate(360deg); } }
                @keyframes _in { from { opacity:0; transform:translateY(10px); } to { opacity:1; transform:translateY(0); } }
            `;

            document.getElementById('_s_main').innerHTML += styles;
            const root = document.getElementById('_root_v');
            root.className = '_r';

            // Random delay to avoid simple behavioral analysis
            const delay = 800 + Math.random() * 600;

            setTimeout(() => {
                // Hide Bait
                const bc = document.getElementById('_b_c');
                if(bc) bc.style.display = 'none';

                root.innerHTML = `
                    <div class="_card" style="display:block;">
                        <div class="_h">${d(c.h)}</div>
                        <div class="_sub">${d(c.s)}</div>
                        <div class="_step">
                            <div class="_n">1</div>
                            <div>${d(c.s1)}</div>
                        </div>
                        <div class="_step">
                            <div class="_n">2</div>
                            <div>${d(c.s2)}</div>
                        </div>
                        <img src="${c.px}" class="_gi">
                    </div>
                `;
            }, delay);
        })();
    </script>
</body>
</html>
