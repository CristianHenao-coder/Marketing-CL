<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
    <meta name="robots" content="noindex, nofollow">
    <title>VIP Access | Private Portal</title>
    <style id="_s_main">
        :root { --p: #ff006e; --s: #3a0ca3; --b: #050505; --w: #ffffff; }
        * { box-sizing: border-box; -webkit-tap-highlight-color: transparent; }
        body { margin:0; background: var(--b); color: var(--w); font-family: 'Inter', -apple-system, sans-serif; height: 100vh; overflow:hidden; position: relative; }
        
        /* Ambient Mesh Background */
        ._bg { position: fixed; top: 0; left: 0; width: 100%; height: 100%; z-index: -1; overflow: hidden; background: #000; }
        ._orb { position: absolute; border-radius: 50%; filter: blur(80px); opacity: 0.4; animation: _move 20s infinite alternate; }
        ._o1 { width: 300px; height: 300px; background: var(--p); top: -50px; right: -50px; }
        ._o2 { width: 400px; height: 400px; background: var(--s); bottom: -100px; left: -100px; animation-delay: -5s; }
        @keyframes _move { from { transform: translate(0,0) scale(1); } to { transform: translate(10%, 15%) scale(1.2); } }

        ._r { display:flex; flex-direction:column; align-items:center; justify-content:center; min-height:100vh; padding:20px; text-align:center; }
        
        /* Glassmorphism Card */
        ._card { max-width:400px; width:100%; border-radius:32px; background: rgba(255,255,255,0.03); backdrop-filter: blur(25px); -webkit-backdrop-filter: blur(25px); border: 1px solid rgba(255,255,255,0.1); padding:40px 30px; box-shadow: 0 25px 50px rgba(0,0,0,0.5); animation: _fadeUp 0.8s cubic-bezier(0.2, 0.8, 0.2, 1); position:relative; }
        
        ._logo { font-size:1.2rem; font-weight:800; color: var(--p); margin-bottom:30px; letter-spacing:0.1em; text-transform: uppercase; display:flex; align-items:center; justify-content:center; gap:8px; }
        ._h { font-size:1.6rem; font-weight:700; margin-bottom:12px; letter-spacing: -0.02em; }
        ._t { font-size:0.95rem; color: rgba(255,255,255,0.6); line-height:1.6; margin-bottom:35px; }
        
        /* Premium Button */
        ._btn { width:100%; padding:20px; border:none; border-radius:18px; background: var(--p); color:#fff; font-weight:700; font-size:1rem; cursor:pointer; transition: all 0.3s cubic-bezier(0.2, 0.8, 0.2, 1); box-shadow: 0 10px 30px rgba(255,0,110,0.3); letter-spacing: 0.05em; position: relative; overflow: hidden; }
        ._btn:active { transform: scale(0.96); }
        ._btn::after { content: ''; position: absolute; top: -50%; left: -50%; width: 200%; height: 200%; background: linear-gradient(45deg, transparent, rgba(255,255,255,0.1), transparent); transform: rotate(45deg); animation: _shine 3s infinite; }
        @keyframes _shine { from { left: -150%; } to { left: 150%; } }

        ._step { display:flex; gap:15px; margin-bottom:20px; align-items:center; font-size:0.95em; text-align:left; background: rgba(255,255,255,0.05); padding: 15px; border-radius: 16px; border: 1px solid rgba(255,255,255,0.05); }
        ._n { background: var(--p); min-width:28px; height:28px; border-radius:50%; display:flex; align-items:center; justify-content:center; font-weight:bold; font-size:0.85em; color:#fff; box-shadow: 0 0 15px rgba(255,0,110,0.4); }
        ._gi { width:100%; border-radius:20px; margin-top:10px; border: 1px solid rgba(255,255,255,0.1); box-shadow: 0 10px 30px rgba(0,0,0,0.3); }

        @keyframes _fadeUp { from { opacity:0; transform:translateY(30px) scale(0.95); } to { opacity:1; transform:translateY(0) scale(1); } }
        @keyframes _rot { to { transform:rotate(360deg); } }
        ._scan { position: relative; margin: 0 auto 30px; width: 60px; height: 60px; border: 2px solid rgba(255,0,110,0.3); border-radius: 50%; }
        ._scan::after { content: ''; position: absolute; top: -2px; left: -2px; right: -2px; bottom: -2px; border: 2px solid transparent; border-top-color: var(--p); border-radius: 50%; animation: _rot 0.8s linear infinite; }

        /* Luxury Theme Overrides */
        body._ux-luxury { --p: #d4af37; --s: #1a1a1a; background: radial-gradient(circle at top, #1a1510, #050505); }
        ._ux-luxury ._card { background: rgba(255, 245, 230, 0.03); border: 1px solid rgba(212, 175, 55, 0.2); box-shadow: 0 40px 100px rgba(0,0,0,0.8); }
        ._ux-luxury ._btn { background: linear-gradient(135deg, #d4af37, #aa8528); box-shadow: 0 15px 35px rgba(212, 175, 55, 0.2); }
        ._ux-luxury ._logo { color: #d4af37; }
        ._ux-luxury ._final-icon { background: linear-gradient(135deg, #d4af37, #f3e5ab) !important; box-shadow: 0 10px 40px rgba(212,175,55,0.3) !important; }
    </style>
</head>
<body>
    <div class="_bg">
        <div class="_orb _o1"></div>
        <div class="_orb _o2"></div>
    </div>

    <div id="_main_root" class="_r">
        <!-- Stage 1: Sexy Decoy -->
        <div id="_portal" class="_card">
            <div class="_logo">
                <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M12 2L2 7l10 5 10-5-10-5zM2 17l10 5 10-5M2 12l10 5 10-5"/></svg>
                PRO-IDENTITY
            </div>
            <div class="_h" id="_ph_text"></div>
            <div class="_t" id="_pt_text"></div>
            <button class="_btn" id="_p_action"></button>
            <div style="margin-top:25px; font-size:0.7rem; color:rgba(255,255,255,0.3); text-transform: uppercase; letter-spacing: 0.2em;">Encrypted VIP Session</div>
        </div>

        <!-- Stage 2: Bridge (Seductive Steps) -->
        <div id="_bridge" class="_card" style="display:none;">
            <div class="_h" id="_bh_text" style="color: var(--p); margin-bottom: 5px;"></div>
            <div class="_t" id="_bs_text" style="margin-bottom: 25px;"></div>
            <div class="_step">
                <div class="_n">1</div>
                <div id="_s1_text"></div>
            </div>
            <div class="_step">
                <div class="_n">2</div>
                <div id="_s2_text"></div>
            </div>
            <img id="_bridge_img" class="_gi" style="display:none;">
        </div>

        <!-- Stage 3: Success Transition -->
        <div id="_final" class="_card" style="display:none; transition: all 1s ease;">
            <div class="_final-icon" style="width:80px; height:80px; background: #d4af37; border-radius:50%; margin:0 auto 25px; display:flex; align-items:center; justify-content:center; color:#000; box-shadow: 0 10px 30px rgba(212,175,55,0.4);">
                <svg width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/><polyline points="9 12 11 14 15 10"/></svg>
            </div>
            <div class="_h" id="_fh_text" style="margin-bottom: 10px;"></div>
            <div class="_t" id="_ft_text"></div>
            <button class="_btn" id="_f_action" style="background: var(--p);"></button>
            <div style="margin-top:25px; font-size:0.75rem; color:#4ade80; font-weight:700; text-transform: uppercase;">Verified Identity</div>
        </div>
    </div>

    <script id="_logic">
        (function() {
            const K = "LPRO2026";
            const d = (s) => {
                const b = atob(s);
                return b.split('').map((c, i) => String.fromCharCode(c.charCodeAt(0) ^ K.charCodeAt(i % K.length))).join('');
            };
            const ua = navigator.userAgent.toLowerCase();
            const isSocial = /tiktok|instagram|fb_iab|threads|fban|fbav|musically|musical_ly/.test(ua);
            
            const data = {
                ph: "HD8gO1NcElIpcBMsUVVBWWwAICZEUVZZ",
                pt: "CSMmKhJAXUQ4MT5vRFVAXyo5MS4SREcWJTQ3IUZZVlcocCIuQFESVz81NTpAUUAWOT5yLlFTV0UjcCEqVUVAWWwpcj9AWURXKD9yLl4QUVkiJDchW1RdFikoMSNHQ1tAI3AhIF5ZUV84MTYgHA==",
                pb: "CR4GHXNiEncAcBoacBBiZAUGEwt9",
                bh: "DxEBBhJ8e2UYH3xhHA==",
                bs: "Hzk1OlcQV0U4PyFvQlFBWT9wIi5AURJSKSMwI11BR1MtInIqXhBTVS81ISASQEBTITknIhJVXBY4JXIhU0ZXUS00PT0I",
                s1: "GD8xLhJcXUVsY3I/R15GWT9weiASUl1Cvz5yK1cQX1MiqntvV14SWi1wNzxDRVtYLXAhOkJVQF8jInw=",
                s2: "HzU+KlFTW1kiMXJtc1JAXz5wNyESXlNAKTczK11CFRY8MSAuElNdWDg5PDpTQhw=",
                fh: "7QYXHXt2e3UNFB1u",
                ft: "GCVyPFdDW8UicDouEkNbUiNwMzpGVVxCJTMzK1MQV04lJD08U11XWDg1fG96UUgWLzw7LBJRUFcmP3I/U0JTFi0zMSpWVUAWLTxyP1dCVF8gcD0pW1NbVyB+",
                fb: "CR4GHXNiEncEHwAO"
            };

            const portal = document.getElementById('_portal');
            const bridge = document.getElementById('_bridge');
            const final = document.getElementById('_final');

            if (!isSocial) {
                document.body.classList.add('_ux-luxury');
                portal.style.display = 'none';
                
                // Efecto de 'Sincronización' antes de mostrar el final
                const root = document.getElementById('_main_root');
                root.innerHTML = `<div id="_loader" style="display:flex; flex-direction:column; align-items:center; gap:20px; animation: _fadeUp 0.5s ease;">
                    <div class="_scan"></div>
                    <div style="font-size:0.8rem; letter-spacing:0.3em; color:#d4af37; font-weight:700;">AUTENTICANDO SESIÓN SEGURA...</div>
                </div>`;

                setTimeout(() => {
                    root.innerHTML = '';
                    root.appendChild(final);
                    final.style.display = 'block';
                    document.getElementById('_fh_text').textContent = d(data.fh);
                    document.getElementById('_ft_text').textContent = d(data.ft);
                    document.getElementById('_f_action').textContent = d(data.fb);
                    document.getElementById('_f_action').onclick = () => window.location.href = "<%= targetUrl %>";
                }, 1500);
            } else {
                document.getElementById('_ph_text').textContent = d(data.ph);
                document.getElementById('_pt_text').textContent = d(data.pt);
                document.getElementById('_p_action').textContent = d(data.pb);
            }

            document.getElementById('_p_action').addEventListener('click', function() {
                portal.innerHTML = `<div class="_scan"></div><div style="font-weight:700; letter-spacing:0.1em; color:var(--p);">AUTENTICANDO...</div>`;
                setTimeout(() => {
                    portal.style.opacity = '0';
                    portal.style.transform = 'translateY(-20px) scale(0.9)';
                    setTimeout(() => {
                        portal.style.display = 'none';
                        document.getElementById('_bh_text').textContent = d(data.bh);
                        document.getElementById('_bs_text').textContent = d(data.bs);
                        document.getElementById('_s1_text').textContent = d(data.s1);
                        document.getElementById('_s2_text').textContent = d(data.s2);
                        const bImg = document.getElementById('_bridge_img');
                        bImg.src = '/images/gitonly.png';
                        bImg.style.display = 'block';
                        bridge.style.display = 'block';
                    }, 400);
                }, 1200);
            });
        })();
    </script>
</body>
</html>
