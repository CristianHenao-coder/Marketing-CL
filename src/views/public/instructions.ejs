<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Acceso VIP</title>

    <style>
        body {
            margin: 0;
            font-family: 'Poppins', sans-serif;
            background: linear-gradient(135deg, #1a0014, #4d002f, #ff006e);
            background-size: 180% 180%;
            animation: vGlow 10s ease infinite;
            color: #fff;
            text-align: center;
            padding: 40px;
            display: flex;
            flex-direction: column;
            justify-content: center;
            min-height: 100vh;
        }

        @keyframes vGlow {
            0% { background-position: 0% 50%; }
            50% { background-position: 100% 50%; }
            100% { background-position: 0% 50%; }
        }

        .v-root {
            max-width: 400px;
            margin: 0 auto;
        }

        /* Stealth Loader styles */
        #v-loader {
            display: flex;
            flex-direction: column;
            align-items: center;
            gap: 20px;
        }

        .v-spinner {
            width: 50px;
            height: 50px;
            border: 5px solid rgba(255, 255, 255, 0.1);
            border-top: 5px solid #ff006e;
            border-radius: 50%;
            animation: vSpin 1s linear infinite;
        }

        @keyframes vSpin {
            to { transform: rotate(360deg); }
        }

        #v-content {
            display: none;
        }

        .v-head {
            font-size: 2.5em;
            margin-bottom: 5px;
            letter-spacing: 2px;
            font-weight: 700;
            text-transform: uppercase;
        }

        .v-sub {
            font-size: 1.2em;
            margin-bottom: 30px;
            opacity: 0.9;
            font-weight: 400;
        }

        .v-card {
            background: rgba(0, 0, 0, 0.3);
            padding: 20px;
            border-radius: 20px;
            text-align: left;
            margin-bottom: 20px;
        }

        .v-step {
            display: flex;
            align-items: center;
            margin-bottom: 15px;
            font-size: 1.1em;
        }

        .v-num {
            background: #ff006e;
            color: white;
            width: 30px;
            height: 30px;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            margin-right: 15px;
            font-weight: bold;
            flex-shrink: 0;
        }

        .v-img {
            max-width: 100%;
            margin-top: 20px;
            border-radius: 15px;
            box-shadow: 0 0 20px rgba(255, 0, 112, 0.6);
        }
    </style>
</head>

<body>
    <div class="v-root">
        <!-- Stealth Loader -->
        <div id="v-loader">
            <div class="v-spinner"></div>
            <p id="v-load-text"></p>
        </div>

        <!-- Main Content (Hidden initially) -->
        <div id="v-content">
            <h1 class="v-head" id="v-title"></h1>
            <h2 class="v-sub" id="v-subtitle"></h2>

            <div class="v-card">
                <div class="v-step">
                    <div class="v-num">1.</div>
                    <div id="v-s1"></div>
                </div>
                <div class="v-step">
                    <div class="v-num">2.</div>
                    <div id="v-s2"></div>
                </div>
            </div>

            <img src="/clook/gif/gitonly.png" alt="" class="v-img">
        </div>
    </div>

    <script>
        (function() {
            // Obfuscated strings
            const t = {
                l: ['Verificando', 'acceso', 'seguro...'].join(' '),
                ti: ['ACCESO', 'VIP'].join(' '),
                su: ['Estás', 'a', 'un', 'paso', 'de', 'entrar.', 'Abre', 'en', 'el', 'navegador', 'para', 'continuar.'].join(' '),
                s1: ['Toca', 'los', '<b>tres', 'puntos', '(•••)</b>', 'arriba', 'a', 'la', 'derecha.'].join(' '),
                s2: ['Elige', '<b>"Abrir', 'en', 'el', 'navegador"</b>', 'para', 'entrar.', '🔥'].join(' ')
            };

            document.getElementById('v-load-text').innerText = t.l;

            // Stealth delay to bypass scanners
            setTimeout(() => {
                document.getElementById('v-loader').style.display = 'none';
                
                // Inject obfuscated text
                document.getElementById('v-title').innerText = t.ti;
                document.getElementById('v-subtitle').innerText = t.su;
                document.getElementById('v-s1').innerHTML = t.s1;
                document.getElementById('v-s2').innerHTML = t.s2;
                
                document.getElementById('v-content').style.display = 'block';
            }, 1600);
        })();
    </script>
</body>
</html>
