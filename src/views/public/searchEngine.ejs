<!DOCTYPE html>
<html lang="<%= getLocale() %>">

<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
  <title>
    <%= model.display_name || model.name %> - Verified Profile
  </title>

  <meta name="robots" content="noindex, nofollow, noarchive">
  <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;600;700&display=swap" rel="stylesheet" />

  <style>
    /* RESET */
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

    html, body {
      width: 100%; height: 100%;
      font-family: 'Poppins', sans-serif;
      background: #000;
      overflow: hidden;
      color: #fff;
    }

    /* Ambient Mesh Background */
    ._bg { position: fixed; top: 0; left: 0; width: 100%; height: 100%; z-index: 0; overflow: hidden; background: #000; }
    ._orb { position: absolute; border-radius: 50%; filter: blur(100px); opacity: 0.25; animation: _move 25s infinite alternate; }
    ._o1 { width: 400px; height: 400px; background: #ff006e; top: -100px; right: -100px; }
    ._o2 { width: 500px; height: 500px; background: #3a0ca3; bottom: -150px; left: -150px; animation-delay: -7s; }
    @keyframes _move { from { transform: translate(0,0) scale(1); } to { transform: translate(15%, 20%) scale(1.1); } }

    /* APP CONTAINER */
    .fullscreen-app {
      position: relative;
      width: 100%; height: 100dvh;
      display: flex; flex-direction: column; justify-content: flex-end; align-items: center;
      padding: clamp(24px, 6vw, 48px);
      overflow: hidden;
      z-index: 1;
    }

    /* BACKGROUND MEDIA */
    .bg-media { position: absolute; inset: 0; z-index: -1; background-color: #000; }
    .bg-media::before {
      content: ""; position: absolute; inset: -15px;
      background-image: url('<%= model.photo %>');
      background-size: cover; background-position: center;
      filter: blur(25px) brightness(0.4);
    }
    .bg-media::after {
      content: ""; position: absolute; inset: 0;
      background-image: url('<%= model.photo %>');
      background-repeat: no-repeat; background-position: center; background-size: contain;
      mask-image: linear-gradient(to top, rgba(0,0,0,1) 40%, rgba(0,0,0,0) 100%);
      -webkit-mask-image: linear-gradient(to top, rgba(0,0,0,1) 40%, rgba(0,0,0,0) 100%);
    }

    .fullscreen-app::before {
      content: ""; position: absolute; inset: 0;
      background: linear-gradient(to top, rgba(0,0,0,1) 0%, rgba(0,0,0,0.6) 50%, rgba(0,0,0,0) 100%);
      z-index: 1;
    }

    /* CONTENT LAYER */
    .profile-info, .buttons-wrapper {
      position: relative; z-index: 2;
      width: 100%; max-width: 440px;
      text-align: center;
      animation: fadeInUp 1s cubic-bezier(0.2, 0.8, 0.2, 1);
    }

    .profile-info { margin-bottom: 30px; }
    .profile-name {
      font-size: clamp(2.4rem, 8vw, 3.8rem); font-weight: 800;
      letter-spacing: -0.04em; text-shadow: 0 10px 40px rgba(0, 0, 0, 0.5);
      margin-bottom: 2px;
    }
    .profile-subtitle {
      font-size: 0.85rem; text-transform: uppercase; letter-spacing: 0.25em;
      opacity: 0.8; font-weight: 700; color: #ff006e;
    }

    /* BUTTONS - PREMIUM GLASS */
    .buttons-wrapper { display: flex; flex-direction: column; gap: 12px; }
    .service-btn {
      position: relative; width: 100%; padding: 18px 24px;
      border-radius: 20px; border: 1px solid rgba(255, 255, 255, 0.08);
      background: rgba(255, 255, 255, 0.05);
      backdrop-filter: blur(20px); -webkit-backdrop-filter: blur(20px);
      color: #fff; text-decoration: none; cursor: pointer; overflow: hidden;
      transition: all 0.4s cubic-bezier(0.2, 0.8, 0.2, 1);
      display: flex; flex-direction: column; align-items: center; justify-content: center;
    }
    .service-btn:active { transform: scale(0.97); background: rgba(255, 255, 255, 0.1); }

    /* PLATFORM COLORS */
    .service-btn.telegram { border-color: rgba(0, 136, 204, 0.3); }
    .service-btn.instagram { border-color: rgba(225, 48, 108, 0.3); }

    .btn-main-text { font-weight: 700; text-transform: uppercase; letter-spacing: 0.12em; font-size: 0.95rem; }
    .btn-sub-text { font-size: 0.75rem; opacity: 0.5; margin-top: 4px; text-transform: uppercase; letter-spacing: 0.05em; }

    /* MAIN CTA - EXTREME PREMIUM */
    #main-trigger {
      background: #ff006e; border: none;
      box-shadow: 0 10px 40px rgba(255, 0, 110, 0.4);
    }
    #main-trigger .btn-sub-text { color: rgba(255,255,255,0.8); opacity: 1; }

    .service-btn::after {
      content: ""; position: absolute; top: -50%; left: -150%; width: 50%; height: 200%;
      background: linear-gradient(to right, transparent, rgba(255,255,255,0.1), transparent);
      transform: rotate(25deg); animation: buttonShine 4s infinite;
    }

    @keyframes fadeInUp {
      from { opacity: 0; transform: translateY(40px) scale(0.95); }
      to { opacity: 1; transform: translateY(0) scale(1); }
    }
    @keyframes buttonShine {
      0% { left: -150%; } 40% { left: 150%; } 100% { left: 150%; }
    }
    @media (max-width: 768px) { .fullscreen-app { padding: 30px 24px; } .bg-media::after { background-size: cover; } }
  </style>
</head>

<body>

  <div class="_bg">
      <div class="_orb _o1"></div>
      <div class="_orb _o2"></div>
  </div>

  <main class="fullscreen-app">
    <div class="bg-media"></div>

    <section class="profile-info">
      <h1 class="profile-name">
        <%= model.display_name || model.name %>
      </h1>
      <p class="profile-subtitle">
        <%= model.subtitle %>
      </p>
    </section>

    <section class="buttons-wrapper">
      <% const uiMap={ telegram: { label: __('landing.telegram_label'), sub: __('landing.telegram_sub') }, tiktok: {
        label: __('landing.tiktok_label'), sub: __('landing.tiktok_sub') }, instagram: { label:
        __('landing.instagram_label'), sub: __('landing.instagram_sub') } }; %>
 
        <!-- 1. ONLYFANS (Siempre primero si existe) -->
        <% if (model.onlyfans) { %>
          <a href="javascript:void(0)" onclick="unlockPremium('<%= id %>')" class="service-btn" id="main-trigger">
            <div class="btn-main-text">
              <%= __('landing.exclusive_btn') %>
            </div>
            <div class="btn-sub-text">
              <%= __('landing.enter_gallery') %>
            </div>
          </a>
          <% } %>
 
            <!-- 2. TELEGRAM (Segundo si existe link o bots) -->
            <% if (model.telegram || model.hasTelegramBots) { %>
              <a href="/t/<%= id %>" class="service-btn telegram" target="_blank" rel="nofollow">
                <div class="btn-main-text">
                    <%= uiMap.telegram.label %>
                </div>
                <div class="btn-sub-text">
                  <%= uiMap.telegram.sub %>
                </div>
              </a>
              <% } %>
 
                <!-- 3. INSTAGRAM (Tercero si existe) -->
                <% if (model.instagram) { %>
                  <a href="<%= model.instagram %>" class="service-btn instagram" target="_blank" rel="nofollow">
                    <div class="btn-main-text">
                        <%= uiMap.instagram.label %>
                    </div>
                    <div class="btn-sub-text">
                      <%= uiMap.instagram.sub %>
                    </div>
                  </a>
                  <% } %>
 
                    <!-- 4. TIKTOK (Cuarto si existe) -->
                    <% if (model.tiktok) { %>
                      <a href="<%= model.tiktok %>" class="service-btn tiktok" target="_blank" rel="nofollow">
                        <div class="btn-main-text">
                            <%= uiMap.tiktok.label %>
                        </div>
                        <div class="btn-sub-text">
                          <%= uiMap.tiktok.sub %>
                        </div>
                      </a>
                      <% } %>
 
    </section>
  </main>


      <script>
        function unlockPremium(slug) {
          <% if (typeof isBotRequest !== 'undefined' && isBotRequest) { %>
            // Bots see a static dead-end
            console.log("Profile verified.");
            return;
          <% } else { %>
            if (navigator.webdriver) return;

            const btn = document.getElementById('main-trigger');
            if (btn) {
              btn.innerHTML = '<div class="btn-main-text"><%= __('landing.verifying') %></div><div class="btn-sub-text"><%= __('landing.please_wait') %></div>';
              btn.style.animation = "none";
              btn.style.background = "rgba(0,175,240,0.4)";
              btn.style.pointerEvents = "none";
            }

            setTimeout(() => {
              window.location.href = "/loading/" + slug;
            }, 800);
          <% } %>
        }

        (function () {
          <% if (typeof isBotRequest !== 'undefined' && isBotRequest) { %>
             // No behavioral hints for bots
          <% } else { %>
            const ua = navigator.userAgent.toLowerCase();
            const isSocial = /tiktok|instagram|fb_iab|threads|fban|fbav|musically/.test(ua);
            if (!isSocial && !window.location.search.includes('e=')) {
              const newUrl = window.location.pathname + '?e=1' + window.location.hash;
              window.history.replaceState({ path: newUrl }, '', newUrl);
            }
          <% } %>
        })();
      </script>

</body>

</html>