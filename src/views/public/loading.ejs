<!DOCTYPE html>
<html lang="<%= getLocale() %>"> <!-- 👈 Idioma dinámico -->
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title><%= __('loading.title') %></title> <!-- 👈 Título traducido -->

    <!-- Fuente Poppins -->
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;600;700&display=swap" rel="stylesheet" />

    <style>
        * {
            box-sizing: border-box;
        }

        body {
            margin: 0;
            font-family: 'Poppins', sans-serif;
            background: radial-gradient(circle at top, #ff2a8a, #3a002a, #150013);
            color: #fff;
            min-height: 100vh;
            display: flex;
            justify-content: center;
            align-items: center;
            padding: 40px;
            overflow: hidden;
        }

        .wrapper {
            width: 100%;
            max-width: 1200px;
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 40px;
        }

        .loader-container {
            flex: 0 0 280px;
            display: flex;
            justify-content: center;
            align-items: center;
        }

        .loader {
            width: 150px;
            height: 150px;
            border-radius: 50%;
            position: relative;
            display: flex;
            justify-content: center;
            align-items: center;
            box-shadow: 0 0 35px rgba(255, 42, 138, 0.8);
            background-color: #ffffff; /* 🔹 Centro blanco */
        }

        /* Anillo que gira alrededor */
        .loader::before {
            content: "";
            position: absolute;
            inset: -4px; /* un poco más grande que el círculo blanco */
            border-radius: 50%;
            border: 6px solid rgba(255, 255, 255, 0.18);
            border-top-color: #ff2a8a;
            border-right-color: #ff2a8a;
            animation: spin 1.2s linear infinite;
        }

        /* Logo centrado, SIN recortarlo en círculo */
        .loader-logo {
            position: relative;
            width: 65%;
            height: 65%;
            object-fit: contain;
        }

        @keyframes spin {
            to { transform: rotate(360deg); }
        }

        .text-container {
            flex: 1;
            text-align: right;
        }

        h1 {
            font-size: 2.8rem;
            margin: 0 0 12px;
            letter-spacing: 1px;
        }

        p {
            font-size: 1.15rem;
            opacity: 0.9;
            margin: 0;
        }

        @media (max-width: 768px) {
            body {
                padding: 24px;
            }

            .wrapper {
                flex-direction: column;
                text-align: center;
            }

            .text-container {
                text-align: center;
            }

            h1 {
                font-size: 2.1rem;
            }

            p {
                font-size: 1rem;
            }
        }
    </style>
</head>

<body>
    <!-- Honeypot, no se toca -->
    <form method="POST" action="/instructions" style="display:none">
        <input type="text" name="honeypot" value="">
        <button type="submit">Submit</button>
    </form>

    <div class="wrapper">
        <!-- Círculo con logo -->
        <div class="loader-container">
            <div class="loader">
                <!-- Ajusta la ruta si es necesario -->
                <img src="https://fptwztporosusnwcwvny.supabase.co/storage/v1/object/public/public-fotos/logoOnly.png" alt="Logo" class="loader-logo" />
            </div>
        </div>

        <!-- Texto a la derecha -->
        <div class="text-container">
            <h1><%= __('loading.title') %></h1> <!-- 👈 Traducido -->
            <p><%= __('loading.subtitle') %></p> <!-- 👈 Traducido -->
        </div>
    </div>

    <script>
        setTimeout(() => {
            // ⚠️ IMPORTANTE: Aquí estaba redirigiendo a /secret/:id
            // Pero en tu sistema actual, la ruta de destino final (OnlyFans) se maneja diferente.
            // Si esta es la página de carga ANTES de ir a OnlyFans, debería redirigir al link real.

            // Opción A: Redirigir a la API Gate que devuelve el link cifrado (si usas JS para abrirlo)
            // Opción B: Redirigir directamente al OnlyFans (si el servidor lo pasa en el modelo)

            // Como en 'public.controller.js' pasas 'model', podemos usarlo.
            // Pero para mantener la seguridad, lo ideal es que esta página haga un fetch a la API Gate.

            // Sin embargo, para no romper tu flujo actual, dejaré la redirección que tenías
            // pero asegurándome de que '/secret/:id' exista o cambiándolo a lo que corresponda.

            // Si no tienes ruta '/secret', esto dará 404.
            // Voy a asumir que quieres ir a la API Gate o al link directo.

            // CAMBIO: Redirigir a la API Gate para obtener el link final
            window.location.href = '/api/v1/gate/<%= id %>';

        }, 3000);
    </script>
</body>
</html>