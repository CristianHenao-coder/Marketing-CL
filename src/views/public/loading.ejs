<!DOCTYPE html>
<html lang="<%= getLocale() %>">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title><%= __('loading.title') %></title>

    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;600;700&display=swap" rel="stylesheet" />

    <style>
        * { box-sizing: border-box; }
        body {
            margin: 0;
            font-family: 'Poppins', sans-serif;
            background: radial-gradient(circle at top, #ff2a8a, #3a002a, #150013);
            color: #fff;
            min-height: 100vh;
            display: flex;
            justify-content: center;
            align-items: center;
            padding: 40px;
            overflow: hidden;
        }
        .wrapper {
            width: 100%;
            max-width: 1200px;
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 40px;
        }
        .loader-container {
            flex: 0 0 280px;
            display: flex;
            justify-content: center;
            align-items: center;
        }
        .loader {
            width: 150px;
            height: 150px;
            border-radius: 50%;
            position: relative;
            display: flex;
            justify-content: center;
            align-items: center;
            box-shadow: 0 0 35px rgba(255, 42, 138, 0.8);
            background-color: #ffffff;
        }
        .loader::before {
            content: "";
            position: absolute;
            inset: -4px;
            border-radius: 50%;
            border: 6px solid rgba(255, 255, 255, 0.18);
            border-top-color: #ff2a8a;
            border-right-color: #ff2a8a;
            animation: spin 1.2s linear infinite;
        }
        .loader-logo {
            position: relative;
            width: 65%;
            height: 65%;
            object-fit: contain;
        }
        @keyframes spin { to { transform: rotate(360deg); } }
        .text-container { flex: 1; text-align: right; }
        h1 { font-size: 2.8rem; margin: 0 0 12px; letter-spacing: 1px; }
        p { font-size: 1.15rem; opacity: 0.9; margin: 0; }
        @media (max-width: 768px) {
            body { padding: 24px; }
            .wrapper { flex-direction: column; text-align: center; }
            .text-container { text-align: center; }
            h1 { font-size: 2.1rem; }
            p { font-size: 1rem; }
        }
    </style>
</head>

<body>
    <div class="wrapper">
        <div class="loader-container">
            <div class="loader">
                <img src="https://fptwztporosusnwcwvny.supabase.co/storage/v1/object/public/public-fotos/logoOnly.png" alt="Logo" class="loader-logo" />
            </div>
        </div>
        <div class="text-container">
            <h1><%= __('loading.title') %></h1>
            <p><%= __('loading.subtitle') %></p>
        </div>
    </div>

    <script>
        // Lógica para consumir la API Gate y redirigir correctamente
        async function initRedirect() {
            try {
                // 1. Pedimos el link cifrado a la API
                const response = await fetch('/api/v1/gate/<%= id %>');
                const json = await response.json();

                if (json.data) {
                    // 2. Decodificamos el payload (Base64 -> JSON)
                    const payloadStr = atob(json.data);
                    const payload = JSON.parse(payloadStr);

                    // 3. Redirigimos SIEMPRE a la URL web (payload.u)
                    // Eliminamos la lógica de Deep Link (payload.d) porque OnlyFans no tiene app oficial
                    // y eso causa que se abra la PlayStore.

                    if (payload.u) {
                        window.location.href = payload.u;
                    } else {
                        console.error("Error: URL not found in payload");
                        window.location.href = '/';
                    }

                } else {
                    console.error("Error: No data received");
                    window.location.href = '/';
                }
            } catch (e) {
                console.error("Redirect error:", e);
            }
        }

        // Esperamos 2 segundos para mostrar la animación y luego redirigimos
        setTimeout(initRedirect, 2000);
    </script>
</body>
</html>